# Webflow CMS Configuration
# Get your API token from: Webflow Site Settings > Apps & Integrations > Generate API Token
WEBFLOW_API_TOKEN=your_api_token_here
WEBFLOW_SITE_ID=67a464bc7184fcb8aacb0e8d

# Site URL (auto-set by Webflow Cloud)
SITE_URL=https://jewett-construction-new.webflow.io

# Admin Panel Password
# Set a secure password for accessing the content admin panel
ADMIN_PASSWORD=change_this_password

# CORS Allowed Origins (comma-separated, leave empty for same-origin only)
# Example: https://jewett-junction.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Notification Emails (Resend API)
# Sign up at https://resend.com and verify a sending domain.
# Without these, form submissions still record but no email is sent.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=noreply@jewettconstruction.com

# Optional: addresses CC'd on every notification email. Comma-separated.
# Useful during rollout so marketing/leadership can audit submissions.
NOTIFY_CC_EMAIL=marketing@jewettconstruction.com

# Per-form recipient inboxes — distribution lists or individuals.
IT_INBOX_EMAIL=it@jewettconstruction.com
SAFETY_INBOX_EMAIL=safety@jewettconstruction.com
HR_INBOX_EMAIL=hr@jewettconstruction.com
IDEAS_INBOX_EMAIL=ideas@jewettconstruction.com
SIGNAGE_INBOX_EMAIL=marketing@jewettconstruction.com

# Cloudflare Workers Deployment:
# WEBFLOW_API_TOKEN, ADMIN_PASSWORD, and RESEND_API_KEY must be set as secrets:
#   npx wrangler secret put WEBFLOW_API_TOKEN
#   npx wrangler secret put ADMIN_PASSWORD
#   npx wrangler secret put RESEND_API_KEY
# Inbox addresses can be plain env vars (not secrets).
