---
import '../../generated/fonts.css';
import '../../generated/webflow.css';
import '../site-components/global.css';
import '../styles/global.css';
import MobileNav from '../components/layout/MobileNav.astro';
import SideNav from '../components/layout/SideNav.astro';
import { initCMS } from '../lib/webflow-cms';

interface Props {
  title?: string;
  theme?: string;
  currentSection?: string;
  /** Meta description; a page passes its own for better link previews. */
  description?: string;
}

const {
  title = 'Jewett Junction',
  currentSection = '',
  description = 'Jewett Junction — the Jewett Construction employee intranet. News, safety, HR, events, and team resources in one place.',
} = Astro.props;

// Social preview card, served from the Webflow asset CDN.
const OG_IMAGE = 'https://cdn.prod.website-files.com/67a464bc7184fcb8aacb0e8d/6a84e10241c0b0bd9e132691_jewett-junction-og.png';

// Map section to full path for MobileNav
const currentPath = currentSection ? `/jewett-junction/${currentSection}` : '/jewett-junction/dashboard';

initCMS(Astro.locals);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    {/* The favicon lives under the Webflow Cloud mount path — a root-relative
        /favicon.png 404s in production because the app is mounted at
        /jewett-junction, not at the domain root. */}
    <link rel="icon" type="image/png" href="/jewett-junction/favicon.png" />
    <link rel="apple-touch-icon" href="/jewett-junction/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Internal tool — keep it out of search indexes regardless of the IP gate. */}
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jewett Junction" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <style>
      .glass { background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(12px); }
      @media (max-width: 767px) { .mobile-safe-area { padding-top: max(4.5rem, env(safe-area-inset-top, 0px)); } }

    </style>
  </head>
  <body class="bg-slate-950 text-gray-100 min-h-screen">
    <!-- Mobile Navigation -->
    <MobileNav currentSection={currentSection} />

    <!-- Background -->
    <div class="fixed inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 -z-10"></div>
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl -z-10"></div>
    <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl -z-10"></div>

    <SideNav currentSection={currentSection} />
    <main class="md:pl-56 min-h-screen">
      <div class="p-6 md:p-8 lg:p-10 mobile-safe-area md:pt-6">
        <slot />
      </div>
    </main>

  </body>
</html>
