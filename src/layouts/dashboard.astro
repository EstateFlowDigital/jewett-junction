---
import '../../generated/fonts.css';
import '../site-components/global.css';
import '../styles/global.css';
// DevLink global styles (Webflow components)
import '../../devlink/global.css';
import { AppShell } from '../components/layout/AppShell';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Jewett Junction', description = 'Internal Intranet' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* Root-relative /favicon.png 404s in production: the app is mounted at
        /jewett-junction, so the icon has to be requested under that prefix. */}
    <link rel="icon" type="image/png" href="/jewett-junction/favicon.png" />
    <link rel="apple-touch-icon" href="/jewett-junction/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <AppShell client:load currentPath={currentPath}>
      <slot />
    </AppShell>
  </body>
</html>
