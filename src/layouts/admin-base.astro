---
import '../../generated/fonts.css';
import '../../generated/webflow.css';
import '../site-components/global.css';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Admin | Jewett Junction' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    {/* Root-relative /favicon.png 404s in production: the app is mounted at
        /jewett-junction, so the icon has to be requested under that prefix. */}
    <link rel="icon" type="image/png" href="/jewett-junction/favicon.png" />
    <link rel="apple-touch-icon" href="/jewett-junction/favicon.png" />
  </head>
  <body class="bg-slate-950 text-gray-100 min-h-screen">
    <slot />
  </body>
</html>
