---
import '../../generated/fonts.css';
import '../site-components/global.css';
import '../styles/global.css';

const { pageClass = '' } = Astro.props;
---

<html lang="en" class={pageClass}>
  <head>
    <meta charset="utf-8" />
    {/* Root-relative /favicon.png 404s in production: the app is mounted at
        /jewett-junction, so the icon has to be requested under that prefix. */}
    <link rel="icon" type="image/png" href="/jewett-junction/favicon.png" />
    <link rel="apple-touch-icon" href="/jewett-junction/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Jewett Junction</title>
  </head>
  <body class="__DARK_MODE_CLASS__">
    <slot />
  </body>
</html>

<style is:global>
  html.splash main {
    display: flex !important;
  }

  html.splash ol,
  html.splash ul {
    padding-left: 0 !important;
    margin: 0 !important;
  }
</style>
