---
// Inline file/image preview for detail pages.
// Auto-detects type from URL extension and renders the best preview:
//   - PDF       → embedded iframe (75vh)
//   - Images    → <img> in a contained box
//   - Video     → <video controls>
//   - Office    → Google Docs Viewer (gview) iframe
//   - Other/external → file card with "Open in new tab"
interface Props {
  url?: string | null;
  name?: string;
  accent?: 'blue' | 'purple' | 'orange' | 'cyan' | 'rose' | 'amber' | 'green' | 'emerald' | 'red' | 'slate';
  aspectRatio?: 'video' | 'square' | 'auto';
  height?: string; // tailwind class fragment for iframe/video height (e.g. "h-[75vh]")
}

const { url, name, accent = 'blue', aspectRatio = 'auto', height = 'h-[75vh]' } = Astro.props;

// Skip rendering entirely if no URL
const hasUrl = typeof url === 'string' && url.length > 0;

function getExt(u: string): string {
  try {
    const cleaned = u.split('?')[0].split('#')[0];
    const last = cleaned.split('/').pop() || '';
    const dot = last.lastIndexOf('.');
    return dot >= 0 ? last.slice(dot + 1).toLowerCase() : '';
  } catch {
    return '';
  }
}

function getFilename(u: string): string {
  try {
    const cleaned = u.split('?')[0].split('#')[0];
    return decodeURIComponent(cleaned.split('/').pop() || '');
  } catch {
    return u;
  }
}

const ext = hasUrl ? getExt(url!) : '';
const filename = name || (hasUrl ? getFilename(url!) : '');

const IMAGE_EXTS = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg', 'avif', 'bmp', 'ico'];
const VIDEO_EXTS = ['mp4', 'webm', 'mov', 'ogv'];
const OFFICE_EXTS = ['doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'csv'];

const isImage = IMAGE_EXTS.includes(ext);
const isVideo = VIDEO_EXTS.includes(ext);
const isPdf = ext === 'pdf';
const isOffice = OFFICE_EXTS.includes(ext);
const isInlinePreviewable = isImage || isVideo || isPdf || isOffice;

// Accent → Tailwind utility map (built explicit so Tailwind keeps the classes)
const accentMap: Record<string, { text: string; hover: string; bg: string; border: string }> = {
  blue:    { text: 'text-blue-400',    hover: 'hover:text-blue-300',    bg: 'bg-blue-500/10',    border: 'border-blue-500/30' },
  purple:  { text: 'text-purple-400',  hover: 'hover:text-purple-300',  bg: 'bg-purple-500/10',  border: 'border-purple-500/30' },
  orange:  { text: 'text-orange-400',  hover: 'hover:text-orange-300',  bg: 'bg-orange-500/10',  border: 'border-orange-500/30' },
  cyan:    { text: 'text-cyan-400',    hover: 'hover:text-cyan-300',    bg: 'bg-cyan-500/10',    border: 'border-cyan-500/30' },
  rose:    { text: 'text-rose-400',    hover: 'hover:text-rose-300',    bg: 'bg-rose-500/10',    border: 'border-rose-500/30' },
  amber:   { text: 'text-amber-400',   hover: 'hover:text-amber-300',   bg: 'bg-amber-500/10',   border: 'border-amber-500/30' },
  green:   { text: 'text-green-400',   hover: 'hover:text-green-300',   bg: 'bg-green-500/10',   border: 'border-green-500/30' },
  emerald: { text: 'text-emerald-400', hover: 'hover:text-emerald-300', bg: 'bg-emerald-500/10', border: 'border-emerald-500/30' },
  red:     { text: 'text-red-400',     hover: 'hover:text-red-300',     bg: 'bg-red-500/10',     border: 'border-red-500/30' },
  slate:   { text: 'text-slate-400',   hover: 'hover:text-slate-300',   bg: 'bg-slate-500/10',   border: 'border-slate-500/30' },
};
const a = accentMap[accent] || accentMap.blue;

// Google Docs Viewer URL for Office files
const gviewUrl = hasUrl && isOffice
  ? `https://docs.google.com/gview?url=${encodeURIComponent(url!)}&embedded=true`
  : null;

const aspectClass =
  aspectRatio === 'video' ? 'aspect-video' :
  aspectRatio === 'square' ? 'aspect-square' :
  '';
---

{hasUrl && (
  <div class="rounded-xl overflow-hidden border border-slate-700/50 bg-slate-950">
    {/* Filename strip + open-in-new-tab */}
    <div class="px-4 py-2.5 border-b border-slate-700/50 bg-slate-900/50 flex items-center justify-between text-xs text-slate-400 gap-3">
      <span class="flex items-center gap-2 min-w-0">
        {isImage ? (
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        ) : isVideo ? (
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        ) : isPdf ? (
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        ) : (
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        )}
        <span class="truncate" title={filename}>{filename}</span>
        {ext && <span class="uppercase text-[10px] tracking-wider px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 flex-shrink-0">{ext}</span>}
      </span>
      <a href={url} target="_blank" rel="noopener noreferrer" class={`${a.text} ${a.hover} inline-flex items-center gap-1 flex-shrink-0 transition-colors`} aria-label="Open in new tab">
        <span class="hidden sm:inline">Open in new tab</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>

    {/* Preview body */}
    {isImage ? (
      <a href={url} target="_blank" rel="noopener noreferrer" class={`block bg-slate-950 ${aspectClass}`} aria-label={`Open full size: ${filename}`}>
        <img
          src={url}
          alt={filename}
          class="w-full h-full max-h-[75vh] object-contain"
          loading="lazy"
        />
      </a>
    ) : isVideo ? (
      <div class="bg-black">
        <video
          controls
          preload="metadata"
          class={`w-full ${height} max-h-[75vh]`}
          src={url}
        >
          Your browser doesn't support inline video.
          <a href={url} class={a.text}>Download the video</a> instead.
        </video>
      </div>
    ) : isPdf ? (
      <iframe
        src={url}
        title={`Preview of ${filename}`}
        class={`w-full ${height} bg-white`}
        loading="lazy"
      />
    ) : isOffice && gviewUrl ? (
      <iframe
        src={gviewUrl}
        title={`Preview of ${filename}`}
        class={`w-full ${height} bg-white`}
        loading="lazy"
      />
    ) : (
      /* Unknown / external — show a tidy card with open button */
      <div class={`p-6 ${a.bg} border-t ${a.border}`}>
        <div class="flex items-center gap-4">
          <div class={`w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center flex-shrink-0`}>
            <svg class={`w-6 h-6 ${a.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-white font-medium truncate">{filename}</p>
            <p class="text-xs text-slate-400 mt-0.5">
              {ext ? `${ext.toUpperCase()} file — ` : ''}Click to open in a new tab
            </p>
          </div>
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-flex items-center gap-2 px-4 py-2 min-h-[44px] rounded-lg ${a.text} hover:bg-slate-800/60 border border-slate-700 transition-colors flex-shrink-0`}
          >
            Open
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    )}
  </div>
)}
