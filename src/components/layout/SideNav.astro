---
/**
 * Desktop left navigation.
 *
 * Previously an 80px icon-only rail with hover tooltips, duplicated between
 * themed-page.astro and dashboard/index.astro. Jewett's president asked for
 * the icons to carry visible text, so the rail is now 224px with the label
 * beside each icon — and the markup lives here so the two copies can't drift.
 * The item list itself is shared with the mobile drawer via lib/nav-items.ts.
 *
 * Labels come from the Intranet Sections CMS collection (cached 60s), with a
 * hardcoded fallback so navigation still renders if the fetch fails.
 */
import { getIntranetSections } from '../../lib/webflow-cms';
import { NAV_PRIMARY, NAV_IDEA, NAV_UTILITY, NAV_PATHS, NAV_LOGO_URL } from '../../lib/nav-items';
import { splitBox } from "@/utils/box.ts";

// stacki-box:start (written by scripts/stacki-box.mjs; change it there)
type StackiBox = {
  /** Space inside this component, on all four sides. Empty keeps the design's own spacing. */
  padding?: "none" | "xsmall" | "small" | "medium" | "large" | "xlarge";
  /** Space inside this component, along the top edge. Overrides Padding for that side. */
  paddingTop?: "none" | "xsmall" | "small" | "medium" | "large" | "xlarge";
  /** Space inside this component, along the bottom edge. Overrides Padding for that side. */
  paddingBottom?: "none" | "xsmall" | "small" | "medium" | "large" | "xlarge";
  /** Space inside this component, along the left edge. Overrides Padding for that side. */
  paddingLeft?: "none" | "xsmall" | "small" | "medium" | "large" | "xlarge";
  /** Space inside this component, along the right edge. Overrides Padding for that side. */
  paddingRight?: "none" | "xsmall" | "small" | "medium" | "large" | "xlarge";
  /** Space outside this component, above it. Empty keeps the design's own spacing. */
  marginTop?: "none" | "xsmall" | "small" | "medium" | "large" | "xlarge";
  /** Space outside this component, below it. Empty keeps the design's own spacing. */
  marginBottom?: "none" | "xsmall" | "small" | "medium" | "large" | "xlarge";
  /** Color scheme for this component and everything inside it. Inherit follows the page; Dark uses the app's dark colors. */
  theme?: "inherit" | "dark";
  /** How wide this component can grow. Small keeps it to a readable width; Full fills its column. */
  maxWidth?: "small" | "full" | "none";
};
// stacki-box:end

interface Props extends StackiBox {
  currentSection?: string;
}

const { class: __ownClass, currentSection = '' } = Astro.props as Props & { class?: string };
const __box = splitBox(Astro.props);
const className = [__ownClass, __box.boxClass].filter(Boolean).join(" ") || undefined;

let sectionMap = new Map<string, string>();
try {
  const sections = await getIntranetSections();
  sectionMap = new Map(sections.items.map((s) => [s.slug, s.name]));
} catch {}
const label = (slug: string, fallback: string) => sectionMap.get(slug) || fallback;

const isActive = (slug: string) =>
  currentSection === slug || (slug === 'dashboard' && !currentSection);

const linkClass = (item: { slug: string; accent?: 'amber' | 'red' }) => {
  const active = isActive(item.slug);
  if (item.accent === 'red') {
    return active
      ? 'bg-red-500/20 border border-red-500/30 text-red-400'
      : 'border border-transparent hover:bg-slate-800 text-red-400/80 hover:text-red-300';
  }
  if (item.accent === 'amber') {
    return active
      ? 'bg-amber-500/20 border border-amber-500/30 text-amber-400'
      : 'border border-transparent hover:bg-slate-800 text-amber-400/70 hover:text-amber-400';
  }
  return active
    ? 'bg-blue-500/20 border border-blue-500/30 text-blue-400'
    : 'border border-transparent hover:bg-slate-800 text-slate-400 hover:text-slate-200';
};
---

<aside
  class:list={["fixed left-0 top-0 bottom-0 w-56 glass border-r border-slate-800/50 z-40 hidden md:flex flex-col py-6 px-3", className]}
  aria-label="Main navigation"
>
  <a
    href="/jewett-junction/dashboard"
    class="block px-2 mb-7 rounded-lg hover:opacity-80 transition-opacity"
    aria-label="Jewett Junction home"
  >
    <img
      src={NAV_LOGO_URL}
      alt="Jewett Construction"
      width="1136"
      height="224"
      class="w-full h-auto"
      loading="eager"
      decoding="async"
    />
  </a>

  <nav class="flex-1 flex flex-col gap-1 overflow-y-auto" aria-label="Primary">
    {NAV_PRIMARY.map((item) => (
      <a
        href={item.href}
        class={`flex items-center gap-3 h-11 px-3 rounded-xl transition-all ${linkClass(item)}`}
        aria-current={isActive(item.slug) ? 'page' : undefined}
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={NAV_PATHS[item.slug]} />
        </svg>
        <span class="text-sm font-medium leading-tight min-w-0">{label(item.slug, item.fallback)}</span>
      </a>
    ))}

    <div class="border-t border-slate-700/50 my-2 mx-3"></div>

    <a
      href={NAV_IDEA.href}
      class={`flex items-center gap-3 h-11 px-3 rounded-xl transition-all ${linkClass(NAV_IDEA)}`}
      aria-current={isActive(NAV_IDEA.slug) ? 'page' : undefined}
    >
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={NAV_PATHS[NAV_IDEA.slug]} />
      </svg>
      <span class="text-sm font-medium truncate">{label(NAV_IDEA.slug, NAV_IDEA.fallback)}</span>
    </a>
  </nav>

  <div class="flex flex-col gap-1 pt-2">
    {NAV_UTILITY.map((item) => (
      <a
        href={item.href}
        class={`flex items-center gap-3 h-11 px-3 rounded-xl transition-all ${linkClass(item)}`}
        aria-current={isActive(item.slug) ? 'page' : undefined}
      >
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={NAV_PATHS[item.slug]} />
        </svg>
        <span class="text-sm font-medium leading-tight min-w-0">{label(item.slug, item.fallback)}</span>
      </a>
    ))}
  </div>
</aside>

<style>
  /* Keyboard-only focus ring. The visited/hover states already carry enough
     contrast, so this is scoped to focus-visible to avoid a persistent ring
     after a mouse click. */
  aside a:focus-visible {
    outline: 2px solid rgb(96 165 250);
    outline-offset: 2px;
  }
</style>
