---
/**
 * Catches taps on the mobile menu button that land before the MobileNav island
 * hydrates.
 *
 * The button is server-rendered, so it is visible and looks pressable
 * immediately — but until React attaches its handler a tap does nothing at all.
 * On a phone over a slow connection that window is long enough that people tap,
 * see nothing happen, and decide the menu is broken. (Reported by the client;
 * confirmed in a browser audit where 3 of 4 pages swallowed an immediate tap
 * even though document.readyState was already "complete".)
 *
 * This records the tap; MobileNav replays it on mount. Runs inline and blocking
 * so it is listening before any paint the user can react to.
 */
---

<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;
    var w = window;
    w.__jjNavPending = false;
    document.addEventListener(
      'click',
      function (e) {
        // Once the island is live React owns the button; stop shadowing it.
        if (w.__jjNavReady) return;
        var t = e.target;
        if (!t || !t.closest) return;
        if (!t.closest('[data-mobile-nav-trigger]')) return;
        w.__jjNavPending = true;
      },
      true,
    );
  })();
</script>
