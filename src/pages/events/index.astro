---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { EventsContent } from '../../components/pages/EventsContent';
import { initCMS, getEvents, getUIStrings } from '../../lib/webflow-cms';

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

// Fetch events + ui strings from CMS
let events: any[] = [];
let uiStrings: Record<string, string> = {};
try {
  const [result, ui] = await Promise.all([
    getEvents({ upcoming: true }),
    getUIStrings(),
  ]);
  events = result.items;
  uiStrings = Object.fromEntries(ui);
} catch (error) {
  console.error('Error fetching events:', error);
}
---

<ThemedPage title="Events | Jewett Junction" theme="dark" currentSection="events" description="Upcoming Jewett Construction company events, trainings, and gatherings.">
  <EventsContent client:load theme="dark" events={events} uiStrings={uiStrings} />
</ThemedPage>
