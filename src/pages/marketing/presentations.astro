---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import { Presentation, Download, ArrowLeft } from 'lucide-react';
import { initCMS, getMarketingAssets } from '../../lib/webflow-cms';

initCMS(Astro.locals);

// Presentations are CMS-driven (Marketing Assets, asset-type: Presentation).
const result = await getMarketingAssets({ type: 'Presentation', limit: 50 });
const presentations = result.items;

const getImageUrl = (img: any) => {
  if (!img) return null;
  if (typeof img === 'string') return img;
  if (img.url) return img.url;
  return null;
};
---

<ThemedPage title="Presentations | Jewett Junction" theme="dark" currentSection="marketing">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a href="/jewett-junction/marketing" class="text-slate-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg hover:bg-slate-800" aria-label="Back to Marketing Hub">
        <ArrowLeft className="h-5 w-5" />
      </a>
      <div>
        <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
          <Presentation className="h-7 w-7 text-green-500" />
          Presentation Templates
        </h1>
        <p class="text-slate-400 mt-1">PowerPoint templates and pitch decks</p>
      </div>
    </div>

    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Available Templates</CardTitle>
        <CardDescription className="text-slate-400">
          {presentations.length > 0
            ? `${presentations.length} template${presentations.length > 1 ? 's' : ''} available`
            : 'Upload templates in the admin under Marketing Assets → Asset Type: Presentation.'}
        </CardDescription>
      </CardHeader>
      <CardContent>
        {presentations.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {presentations.map((pres) => {
              const imageUrl = getImageUrl(pres['preview-image']) || getImageUrl(pres.thumbnail);
              const downloadUrl = pres['download-link'];
              return (
                <a
                  href={`/jewett-junction/marketing/${pres.slug || pres.id}`}
                  class="border border-slate-600 rounded-lg overflow-hidden bg-slate-700/50 hover:border-green-500/50 hover:bg-slate-700 transition-colors flex flex-col"
                >
                  <div class="h-36 bg-gradient-to-br from-green-600 to-green-800 flex items-center justify-center overflow-hidden">
                    {imageUrl ? (
                      <img src={imageUrl} alt={pres.name} class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <Presentation className="h-10 w-10 text-white/80" />
                    )}
                  </div>
                  <div class="p-4 flex flex-col gap-2 flex-1">
                    <p class="font-medium text-sm text-white truncate">{pres.name}</p>
                    {pres.description && (
                      <p class="text-xs text-slate-400 line-clamp-2">{pres.description}</p>
                    )}
                    <div class="flex items-center justify-between mt-auto gap-2">
                      {pres['file-format'] && (
                        <Badge variant="secondary" className="bg-slate-600 text-slate-300 uppercase text-xs">
                          {pres['file-format']}
                        </Badge>
                      )}
                      {downloadUrl && (
                        <Button size="sm" variant="outline" className="border-slate-600 text-slate-300 hover:bg-slate-600 ml-auto" asChild>
                          <a href={downloadUrl} target="_blank" rel="noopener noreferrer">
                            <Download className="h-3 w-3 mr-1" /> Download
                          </a>
                        </Button>
                      )}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-8 text-slate-400">
            <Presentation className="h-10 w-10 mx-auto mb-2 opacity-50" />
            <p>No presentation templates uploaded yet.</p>
            <a href="/jewett-junction/admin/marketing" class="text-green-400 hover:underline text-sm mt-1 inline-block">
              Add one in the admin panel →
            </a>
          </div>
        )}
      </CardContent>
    </Card>
  </div>
</ThemedPage>
