---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { Badge } from '../../components/ui/badge';
import { Presentation, Download, ArrowLeft } from 'lucide-react';
import { initCMS, getMarketingAssets, getPageCopy } from '../../lib/webflow-cms';

initCMS(Astro.locals);

// Presentations are CMS-driven (Marketing Assets, asset-type: Presentation).
const [result, copy] = await Promise.all([
  getMarketingAssets({ type: 'Presentation', limit: 50 }),
  getPageCopy('marketing-presentations'),
]);
const presentations = result.items;
const heroHeadline = copy?.['hero-headline'] || '';
const heroSubtitle = copy?.['hero-subtitle'] || '';

const getImageUrl = (img: any) => {
  if (!img) return null;
  if (typeof img === 'string') return img;
  if (img.url) return img.url;
  return null;
};
---

<ThemedPage title={`${heroHeadline || 'Marketing'} | Jewett Junction`} theme="dark" currentSection="marketing">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a href="/jewett-junction/marketing" class="text-slate-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg hover:bg-slate-800" aria-label="Back to Marketing Hub">
        <ArrowLeft className="h-5 w-5" />
      </a>
      <div>
        {heroHeadline && (
          <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
            <Presentation className="h-7 w-7 text-green-500" />
            {heroHeadline}
          </h1>
        )}
        {heroSubtitle && <p class="text-slate-400 mt-1">{heroSubtitle}</p>}
      </div>
    </div>

    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Available Templates</CardTitle>
        <CardDescription className="text-slate-400">
          {presentations.length > 0
            ? `${presentations.length} template${presentations.length > 1 ? 's' : ''} available`
            : 'No presentation templates uploaded yet — check back soon.'}
        </CardDescription>
      </CardHeader>
      <CardContent>
        {presentations.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {presentations.map((pres) => {
              const imageUrl = getImageUrl(pres['preview-image']) || getImageUrl(pres.thumbnail);
              const downloadUrl = pres['download-link'];
              const detailUrl = `/jewett-junction/marketing/${pres.slug || pres.id}`;
              return (
                <div class="group border border-slate-600 rounded-lg overflow-hidden bg-slate-700/50 hover:border-green-500/50 hover:bg-slate-700 transition-colors flex flex-col">
                  {/* Preview links to detail */}
                  <a
                    href={detailUrl}
                    class="block h-36 bg-gradient-to-br from-green-600 to-green-800 flex items-center justify-center overflow-hidden"
                    aria-label={`View ${pres.name} details`}
                  >
                    {imageUrl ? (
                      <img src={imageUrl} alt={pres.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform" loading="lazy" />
                    ) : (
                      <Presentation className="h-10 w-10 text-white/80" />
                    )}
                  </a>

                  <div class="p-4 flex flex-col gap-2 flex-1">
                    <a href={detailUrl} class="block">
                      <p class="font-medium text-sm text-white truncate group-hover:text-green-400 transition-colors">{pres.name}</p>
                      {pres.description && (
                        <p class="text-xs text-slate-400 mt-1">{pres.description}</p>
                      )}
                    </a>

                    <div class="flex items-center justify-between mt-auto gap-2">
                      {pres['file-format'] && (
                        <Badge variant="secondary" className="bg-slate-600 text-slate-300 uppercase text-xs">
                          {pres['file-format']}
                        </Badge>
                      )}
                      {downloadUrl && (
                        <a
                          href={downloadUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 px-3 py-1.5 min-h-[32px] text-xs font-medium border border-slate-600 hover:border-green-500 text-slate-300 hover:text-white hover:bg-green-600 rounded-md transition-colors ml-auto"
                          aria-label={`Download ${pres.name}`}
                        >
                          <Download className="h-3 w-3" />
                          Download
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-8 text-slate-400">
            <Presentation className="h-10 w-10 mx-auto mb-2 opacity-50" />
            <p>No presentation templates uploaded yet — check back soon.</p>
          </div>
        )}
      </CardContent>
    </Card>
  </div>
</ThemedPage>
