---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { Image, Download, ArrowLeft, FileType, Palette } from 'lucide-react';
import { initCMS, getMarketingAssets, getSiteSettings } from '../../lib/webflow-cms';

initCMS(Astro.locals);

// Brand identity is editable in the admin under Site Settings → Brand: …
// Falls back to Jewett's published defaults so the page always renders.
const settings = await getSiteSettings();
const headingFont = settings['brand-heading-font'] || 'Politica';
const bodyFont = settings['brand-body-font'] || 'Lato';
const brandColors = [
  { name: settings['brand-color-1-name'] || 'Jewett Red',  hex: settings['brand-color-1-hex']  || '#D22630' },
  { name: settings['brand-color-2-name'] || 'Jewett Grey', hex: settings['brand-color-2-hex']  || '#78787F' },
  { name: settings['brand-color-3-name'] || 'Jewett Dark', hex: settings['brand-color-3-hex']  || '#2A2A2A' },
].filter((c) => /^#[0-9a-fA-F]{6}$/.test(c.hex));

// Logos and brand guide PDFs come from Marketing Assets. Match by asset-type
// first, then fall back to a name-keyword check so assets uploaded without an
// asset-type set (e.g. "Logo - Vertical") still surface.
const result = await getMarketingAssets({ limit: 100 });
const allAssets = result.items;

function matchesAny(value: string | undefined, needles: string[]): boolean {
  if (!value) return false;
  const v = value.toLowerCase();
  return needles.some((n) => v.includes(n));
}

const logos = allAssets.filter((a: any) =>
  matchesAny(a['asset-type'], ['logo']) || matchesAny(a.name, ['logo']),
);
const guides = allAssets.filter((a: any) =>
  matchesAny(a['asset-type'], ['brand guide', 'guideline']) ||
  matchesAny(a.name, ['brand guideline', 'brand guide', 'brand standard']),
);

const getImageUrl = (img: any) => {
  if (!img) return null;
  if (typeof img === 'string') return img;
  if (img.url) return img.url;
  return null;
};

---

<ThemedPage title="Brand Assets | Jewett Junction" theme="dark" currentSection="marketing">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a href="/jewett-junction/marketing" class="text-slate-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg hover:bg-slate-800" aria-label="Back to Marketing Hub">
        <ArrowLeft className="h-5 w-5" />
      </a>
      <div>
        <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
          <Image className="h-7 w-7 text-blue-500" />
          Brand Assets
        </h1>
        <p class="text-slate-400 mt-1">Official logos and brand guidelines</p>
      </div>
    </div>

    <!-- Logos -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Company Logos</CardTitle>
        <CardDescription className="text-slate-400">
          {logos.length > 0
            ? `${logos.length} logo${logos.length > 1 ? 's' : ''} available`
            : 'Upload logos in the admin panel under Marketing → Asset Type: Logo'}
        </CardDescription>
      </CardHeader>
      <CardContent>
        {logos.length > 0 ? (
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {logos.map((asset) => {
              const imageUrl = getImageUrl(asset['preview-image']) || getImageUrl(asset.thumbnail);
              const downloadUrl = asset['download-link'];
              const detailUrl = `/jewett-junction/marketing/${asset.slug || asset.id}`;
              return (
                <div class="group border border-slate-600 rounded-xl bg-slate-700/40 hover:border-blue-500/50 hover:bg-slate-700/70 transition-colors overflow-hidden flex flex-col">
                  {/* Image preview links to detail page */}
                  <a
                    href={detailUrl}
                    class="block h-32 bg-white flex items-center justify-center overflow-hidden"
                    aria-label={`View ${asset.name} details`}
                  >
                    {imageUrl ? (
                      <img
                        src={imageUrl}
                        alt={asset.name}
                        class="max-w-full max-h-full object-contain p-3 group-hover:scale-105 transition-transform"
                        loading="lazy"
                      />
                    ) : (
                      <Image className="h-8 w-8 text-slate-400" />
                    )}
                  </a>

                  {/* Meta + actions */}
                  <div class="p-3 flex-1 flex flex-col gap-2">
                    <a href={detailUrl} class="block group/title">
                      <p class="font-medium text-sm text-white truncate group-hover/title:text-blue-400 transition-colors">{asset.name}</p>
                      <p class="text-xs text-slate-400 uppercase tracking-wider">{asset['file-format'] || 'Logo'}</p>
                    </a>

                    {downloadUrl ? (
                      <a
                        href={downloadUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-1.5 w-full mt-1 px-3 py-2 min-h-[36px] text-xs font-medium bg-slate-600/60 hover:bg-blue-600 text-slate-200 hover:text-white border border-slate-500/50 hover:border-blue-500 rounded-lg transition-colors"
                        aria-label={`Download ${asset.name}`}
                      >
                        <Download className="h-3.5 w-3.5" />
                        Download
                      </a>
                    ) : (
                      <a
                        href={detailUrl}
                        class="inline-flex items-center justify-center gap-1.5 w-full mt-1 px-3 py-2 min-h-[36px] text-xs font-medium bg-slate-600/60 hover:bg-slate-600 text-slate-200 border border-slate-500/50 rounded-lg transition-colors"
                      >
                        View Details
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-8 text-slate-400">
            <Image className="h-10 w-10 mx-auto mb-2 opacity-50" />
            <p>No logos uploaded yet.</p>
            <a href="/jewett-junction/admin/marketing" class="text-blue-400 hover:underline text-sm mt-1 inline-block">
              Add one in the admin panel →
            </a>
          </div>
        )}
      </CardContent>
    </Card>

    <!-- Brand Colors -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="flex items-center gap-2 text-white">
          <Palette className="h-5 w-5" />
          Brand Colors
        </CardTitle>
        <CardDescription className="text-slate-400">Use these hex values across all materials</CardDescription>
      </CardHeader>
      <CardContent>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {brandColors.map((c) => (
            <div class="rounded-lg border border-slate-600 overflow-hidden">
              <div class="h-24" style={`background-color: ${c.hex}`}></div>
              <div class="p-3 bg-slate-700/40">
                <p class="font-medium text-sm text-white">{c.name}</p>
                <p class="text-xs text-slate-400 font-mono mt-0.5">{c.hex}</p>
              </div>
            </div>
          ))}
        </div>
      </CardContent>
    </Card>

    <!-- Typography -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="flex items-center gap-2 text-white">
          <FileType className="h-5 w-5" />
          Typography
        </CardTitle>
        <CardDescription className="text-slate-400">Approved fonts for digital and print</CardDescription>
      </CardHeader>
      <CardContent>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-3">
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Headings</p>
              <h4 class="text-xl font-semibold text-white">{headingFont}</h4>
            </div>
            <div class="space-y-1 text-white" style={`font-family: '${headingFont}', system-ui, sans-serif;`}>
              <p class="text-3xl font-bold uppercase tracking-wide">Aa Bb Cc 123</p>
              <p class="text-lg uppercase tracking-wide">The Quick Brown Fox</p>
            </div>
          </div>
          <div class="space-y-3">
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Body</p>
              <h4 class="text-xl font-semibold text-white">{bodyFont}</h4>
            </div>
            <div class="space-y-1 text-white" style={`font-family: '${bodyFont}', system-ui, sans-serif;`}>
              <p class="text-2xl">Aa Bb Cc 123</p>
              <p class="text-lg">The quick brown fox jumps over the lazy dog</p>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- Brand Guidelines -->
    {guides.length > 0 && (
      <Card className="bg-slate-800 border-slate-700">
        <CardHeader>
          <CardTitle className="text-white">Brand Guidelines</CardTitle>
          <CardDescription className="text-slate-400">Complete brand standards and usage</CardDescription>
        </CardHeader>
        <CardContent className="space-y-3">
          {guides.map((guide) => {
            const detailUrl = `/jewett-junction/marketing/${guide.slug || guide.id}`;
            return (
              <div class="flex items-center justify-between gap-4 p-4 bg-slate-700 rounded-lg hover:bg-slate-600 transition-colors group">
                <a href={detailUrl} class="flex items-center gap-4 flex-1 min-w-0 min-h-[44px]" aria-label={`View ${guide.name} details`}>
                  <div class="h-12 w-12 bg-red-900/50 rounded flex items-center justify-center flex-shrink-0">
                    <FileType className="h-6 w-6 text-red-400" />
                  </div>
                  <div class="min-w-0">
                    <p class="font-medium text-white truncate group-hover:text-blue-400 transition-colors">{guide.name}</p>
                    <p class="text-sm text-slate-400 truncate">
                      {[guide['file-format'], guide['file-size'], guide.version].filter(Boolean).join(' • ') || 'Brand Guide'}
                    </p>
                  </div>
                </a>
                {guide['download-link'] && (
                  <a
                    href={guide['download-link']}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 min-h-[44px] bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors flex-shrink-0"
                    aria-label={`Download ${guide.name}`}
                  >
                    <Download className="h-4 w-4" />
                    Download
                  </a>
                )}
              </div>
            );
          })}
        </CardContent>
      </Card>
    )}
  </div>
</ThemedPage>
