---
import ThemedPage from '../../layouts/themed-page.astro';
import { initCMS, getMarketingAssetBySlug, getMarketingAssets, decodeHtmlEntities } from '../../lib/webflow-cms';

export const prerender = false;

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

const { slug } = Astro.params;

// Fetch the marketing asset by slug
let item: any = null;
let relatedItems: any[] = [];

try {
  if (slug) {
    item = await getMarketingAssetBySlug(slug);

    // Also fetch other marketing assets
    const result = await getMarketingAssets({ limit: 4 });
    relatedItems = result.items.filter(r => r.slug !== slug).slice(0, 3);
  }
} catch (error) {
  console.error('Error fetching marketing asset:', error);
}

// If item not found, redirect
if (!item) {
  return Astro.redirect('/jewett-junction/marketing');
}

// Get header image (preview image or thumbnail)
const headerImage = item['preview-image']?.url || item.thumbnail?.url || item.image?.url;

// Asset type badge colors
const typeColors: Record<string, { bg: string; text: string; border: string; gradient: string }> = {
  'Brand Asset': { bg: 'bg-rose-500/20', text: 'text-rose-400', border: 'border-rose-500/30', gradient: 'from-rose-500 to-pink-500' },
  'Template': { bg: 'bg-purple-500/20', text: 'text-purple-400', border: 'border-purple-500/30', gradient: 'from-purple-500 to-violet-500' },
  'Photo': { bg: 'bg-blue-500/20', text: 'text-blue-400', border: 'border-blue-500/30', gradient: 'from-blue-500 to-cyan-500' },
  'Video': { bg: 'bg-red-500/20', text: 'text-red-400', border: 'border-red-500/30', gradient: 'from-red-500 to-orange-500' },
  'Document': { bg: 'bg-amber-500/20', text: 'text-amber-400', border: 'border-amber-500/30', gradient: 'from-amber-500 to-orange-500' },
  'default': { bg: 'bg-slate-500/20', text: 'text-slate-400', border: 'border-slate-500/30', gradient: 'from-slate-500 to-slate-600' }
};

const typeStyle = typeColors[item['asset-type'] || ''] || typeColors.default;
---

<ThemedPage title={`${item.name} | Marketing | Jewett Junction`} theme="dark" currentSection="marketing">
  <div>
    <!-- Back link -->
    <a href="/jewett-junction/marketing" class="inline-flex items-center gap-2 text-slate-400 hover:text-rose-400 mb-6 transition-colors min-h-[44px]" aria-label="Back to Marketing Hub">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Marketing Hub
    </a>

    <!-- Header Image / Preview -->
    {headerImage && (
      <div class="relative h-64 md:h-96 rounded-2xl overflow-hidden mb-8 bg-slate-800">
        <img
          src={headerImage}
          alt={item.name}
          class="w-full h-full object-contain"
          loading="eager"
        />
        <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
      </div>
    )}

    <!-- Content Card -->
    <div class="glass rounded-2xl p-8 mb-8 border border-slate-800/50">
      <div class="flex items-start gap-6 mb-6">
        {!headerImage && (
          <div class={`w-16 h-16 bg-gradient-to-br ${typeStyle.gradient} rounded-2xl flex items-center justify-center flex-shrink-0`}>
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
        )}
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            {item['asset-type'] && (
              <span class={`inline-block px-3 py-1 text-xs font-medium rounded-full border ${typeStyle.bg} ${typeStyle.text} ${typeStyle.border}`}>
                {item['asset-type']}
              </span>
            )}
            {item['file-format'] && (
              <span class="inline-block px-3 py-1 text-xs font-medium bg-slate-700 text-slate-300 rounded-full uppercase">
                {item['file-format']}
              </span>
            )}
            {item['file-size'] && (
              <span class="inline-block px-3 py-1 text-xs font-medium bg-slate-700/50 text-slate-400 rounded-full">
                {item['file-size']}
              </span>
            )}
          </div>
          <h1 class="text-3xl font-bold text-white">{item.name}</h1>
          {item.version && (
            <p class="text-slate-400 mt-2">Version: {item.version}</p>
          )}
        </div>
      </div>

      <!-- Description -->
      {item.description && (
        <div class="mb-8 prose prose-invert max-w-none">
          <div class="text-slate-300 leading-relaxed text-lg" set:html={decodeHtmlEntities(item.description)} />
        </div>
      )}

      <!-- Usage Guidelines -->
      {item['usage-guidelines'] && (
        <div class="mb-8 p-4 bg-rose-500/10 border border-rose-500/30 rounded-xl">
          <h3 class="text-rose-400 font-semibold mb-2 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Usage Guidelines
          </h3>
          <div class="text-rose-100" set:html={decodeHtmlEntities(item['usage-guidelines'])} />
        </div>
      )}

      <!-- Tags -->
      {item.tags && (
        <div class="mb-6">
          <h3 class="text-sm font-medium text-slate-400 mb-2">Tags</h3>
          <div class="flex flex-wrap gap-2">
            {item.tags.split(',').map((tag: string) => (
              <span class="px-3 py-1 text-sm bg-slate-800 text-slate-300 rounded-full">
                {tag.trim()}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Actions -->
      <div class="flex flex-wrap gap-4">
        {item['download-link'] && (
          <a
            href={item['download-link']}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-rose-500 hover:bg-rose-600 text-white font-medium rounded-xl transition-colors"
            aria-label="Download Asset (opens in new tab)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download Asset
          </a>
        )}
        {item['preview-link'] && (
          <a
            href={item['preview-link']}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-xl transition-colors"
            aria-label="Preview (opens in new tab)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            Preview
          </a>
        )}
      </div>
    </div>

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <div class="glass rounded-2xl p-6 border border-slate-800/50">
        <h2 class="text-xl font-semibold text-white mb-4">Related Assets</h2>
        <div class="grid gap-4">
          {relatedItems.map((related) => {
            const relatedStyle = typeColors[related['asset-type'] || ''] || typeColors.default;
            return (
              <a
                href={`/jewett-junction/marketing/${related.slug}`}
                class="flex items-center gap-4 p-4 min-h-[44px] rounded-xl hover:bg-slate-800/50 transition-colors group"
                aria-label={`View: ${related.name}`}
              >
                {(related.thumbnail?.url || related['preview-image']?.url) ? (
                  <img src={related.thumbnail?.url || related['preview-image']?.url} alt="" class="w-12 h-12 object-cover rounded-xl flex-shrink-0" loading="lazy" />
                ) : (
                  <div class={`w-12 h-12 bg-gradient-to-br ${relatedStyle.gradient} rounded-xl flex items-center justify-center flex-shrink-0`}>
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    </svg>
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium text-white group-hover:text-rose-400 transition-colors truncate">
                    {related.name}
                  </h3>
                  <p class="text-sm text-slate-400">{related['asset-type'] || 'Marketing Asset'}</p>
                </div>
                <svg class="w-5 h-5 text-slate-500 group-hover:text-rose-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>
</ThemedPage>
