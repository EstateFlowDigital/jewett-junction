---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import { FileText, Download, ArrowLeft, File } from 'lucide-react';
import { initCMS, getMarketingAssets, getPageCopy } from '../../lib/webflow-cms';

initCMS(Astro.locals);

// Single source: Marketing Assets in the admin. Bucket by asset-type / name.
const [result, copy] = await Promise.all([
  getMarketingAssets({ limit: 100 }),
  getPageCopy('marketing-letterhead'),
]);
const assets = result.items;
const heroHeadline = copy?.['hero-headline'] || '';
const heroSubtitle = copy?.['hero-subtitle'] || '';

function matchesAny(value: string | undefined, needles: string[]): boolean {
  if (!value) return false;
  const v = value.toLowerCase();
  return needles.some((n) => v.includes(n));
}

const letterheadAssets = assets.filter((a: any) =>
  matchesAny(a['asset-type'], ['letterhead']) || matchesAny(a.name, ['letterhead']),
);
const formAssets = assets.filter((a: any) => {
  // Logos can be miscategorized here because 'logo' contains the keyword 'log'.
  // Exclude anything explicitly tagged as a logo before keyword matching.
  if (matchesAny(a['asset-type'], ['logo'])) return false;
  if (matchesAny(a['asset-type'], ['form'])) return true;
  if (matchesAny(a.name, ['form', 'request', 'expense', 'time off', 'mileage', 'timesheet'])) return true;
  return false;
});

const getDownloadUrl = (item: any): string | null => item['download-link'] || null;
---

<ThemedPage title={`${heroHeadline || 'Marketing'} | Jewett Junction`} theme="dark" currentSection="marketing">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a href="/jewett-junction/marketing" class="text-slate-400 hover:text-white transition-colors" aria-label="Back to Marketing">
        <ArrowLeft className="h-5 w-5" />
      </a>
      <div>
        {heroHeadline && (
          <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
            <FileText className="h-7 w-7 text-blue-500" />
            {heroHeadline}
          </h1>
        )}
        {heroSubtitle && <p class="text-slate-400 mt-1">{heroSubtitle}</p>}
      </div>
    </div>

    <!-- Letterhead Templates -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Letterhead Templates</CardTitle>
        <CardDescription className="text-slate-400">
          {letterheadAssets.length > 0
            ? `${letterheadAssets.length} ${letterheadAssets.length === 1 ? 'template' : 'templates'} available`
            : 'No letterhead templates uploaded yet — check back soon.'}
        </CardDescription>
      </CardHeader>
      <CardContent>
        {letterheadAssets.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {letterheadAssets.map((asset: any) => {
              const thumb = asset['preview-image']?.url || asset.thumbnail?.url;
              const downloadUrl = getDownloadUrl(asset);
              return (
                <div class="border border-slate-600 rounded-lg overflow-hidden bg-slate-700/40 flex flex-col">
                  <div class="h-36 bg-slate-100 flex items-center justify-center p-3">
                    {thumb ? (
                      <img src={thumb} alt={asset.name} class="max-w-full max-h-full object-contain" loading="lazy" />
                    ) : (
                      <FileText className="h-10 w-10 text-slate-400" />
                    )}
                  </div>
                  <div class="p-4 flex flex-col gap-3 flex-1">
                    <div>
                      <p class="font-medium text-sm text-white">{asset.name}</p>
                      {asset.description && <p class="text-xs text-slate-400 mt-1">{asset.description}</p>}
                    </div>
                    {downloadUrl && (
                      <a href={downloadUrl} target="_blank" rel="noopener noreferrer" class="mt-auto">
                        <Button size="sm" variant="outline" className="w-full border-slate-600 text-slate-300 hover:bg-slate-600">
                          <Download className="h-3 w-3 mr-1" /> Download
                        </Button>
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="rounded-lg border border-dashed border-slate-600 bg-slate-900/40 p-8 text-center">
            <FileText className="h-10 w-10 mx-auto text-slate-500 mb-3" />
            <p class="text-sm text-slate-400">No letterhead templates uploaded yet — check back soon.</p>
          </div>
        )}
      </CardContent>
    </Card>

    <!-- Business Forms -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Business Forms</CardTitle>
        <CardDescription className="text-slate-400">
          {formAssets.length > 0
            ? `${formAssets.length} ${formAssets.length === 1 ? 'form' : 'forms'} available`
            : 'No forms uploaded yet — check back soon.'}
        </CardDescription>
      </CardHeader>
      <CardContent>
        {formAssets.length > 0 ? (
          <div class="space-y-3">
            {formAssets.map((form: any) => {
              const downloadUrl = getDownloadUrl(form);
              const format = (form['file-format'] || '').toString();
              return (
                <div class="flex items-center justify-between p-3 bg-slate-700/50 rounded-lg gap-3">
                  <div class="flex items-center gap-3 min-w-0">
                    <File className="h-5 w-5 text-blue-400 flex-shrink-0" />
                    <div class="min-w-0">
                      <p class="font-medium text-sm text-white truncate">{form.name}</p>
                      {form.description && <p class="text-xs text-slate-400 truncate">{form.description}</p>}
                    </div>
                  </div>
                  <div class="flex gap-2 items-center flex-shrink-0">
                    {format && <Badge variant="secondary" className="bg-slate-600 text-slate-300 uppercase">{format}</Badge>}
                    {downloadUrl && (
                      <a href={downloadUrl} target="_blank" rel="noopener noreferrer">
                        <Button size="sm" variant="outline" className="border-slate-600 text-slate-300 hover:bg-slate-700">
                          <Download className="h-3 w-3 mr-1" /> Download
                        </Button>
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="rounded-lg border border-dashed border-slate-600 bg-slate-900/40 p-8 text-center">
            <File className="h-10 w-10 mx-auto text-slate-500 mb-3" />
            <p class="text-sm text-slate-400">No forms uploaded yet — check back soon.</p>
          </div>
        )}
      </CardContent>
    </Card>
  </div>
</ThemedPage>
