---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { SignageRequestForm } from '../../components/forms/SignageRequestForm';
import { PenTool, ArrowLeft, Clock } from 'lucide-react';
import { initCMS, getSiteSettings, getPageCopy } from '../../lib/webflow-cms';

initCMS(Astro.locals);
const [settings, copy] = await Promise.all([
  getSiteSettings(),
  getPageCopy('marketing-signage'),
]);
const reviewDays = settings['signage-review-days'] || '1-2 business days';
const productionDays = settings['signage-production-days'] || '3-5 business days';
const deliveryDays = settings['signage-delivery-days'] || '1-3 business days';
const heroHeadline = copy?.['hero-headline'] || '';
const heroSubtitle = copy?.['hero-subtitle'] || '';
---

<ThemedPage title={`${heroHeadline || 'Marketing'} | Jewett Junction`} theme="dark" currentSection="marketing">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a href="/jewett-junction/marketing" class="text-slate-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg hover:bg-slate-800" aria-label="Back to Marketing Hub">
        <ArrowLeft className="h-5 w-5" aria-hidden="true" />
      </a>
      <div>
        {heroHeadline && (
          <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
            <PenTool className="h-7 w-7 text-orange-500" aria-hidden="true" />
            {heroHeadline}
          </h1>
        )}
        {heroSubtitle && <p class="text-slate-400 mt-1">{heroSubtitle}</p>}
      </div>
    </div>

    <!-- Request Form -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">New Signage Request</CardTitle>
        <CardDescription className="text-slate-400">Fill out the form below to request new signage. The marketing team will be in touch with proofs and pricing.</CardDescription>
      </CardHeader>
      <CardContent>
        <SignageRequestForm client:load />
      </CardContent>
    </Card>

    <!-- Processing Timeline -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="flex items-center gap-2 text-white">
          <Clock className="h-5 w-5" aria-hidden="true" />
          Processing Timeline
        </CardTitle>
        <CardDescription className="text-slate-400">Typical turnaround once your request is received</CardDescription>
      </CardHeader>
      <CardContent>
        <div class="flex flex-col md:flex-row gap-4">
          <div class="flex-1 flex items-center gap-3 p-3 bg-slate-700/50 rounded-lg">
            <div class="h-8 w-8 bg-blue-900/50 rounded-full flex items-center justify-center">
              <span class="text-blue-400 font-bold text-sm">1</span>
            </div>
            <div>
              <p class="font-medium text-sm text-white">Request Review</p>
              <p class="text-xs text-slate-400">{reviewDays}</p>
            </div>
          </div>
          <div class="flex-1 flex items-center gap-3 p-3 bg-slate-700/50 rounded-lg">
            <div class="h-8 w-8 bg-orange-900/50 rounded-full flex items-center justify-center">
              <span class="text-orange-400 font-bold text-sm">2</span>
            </div>
            <div>
              <p class="font-medium text-sm text-white">Production</p>
              <p class="text-xs text-slate-400">{productionDays}</p>
            </div>
          </div>
          <div class="flex-1 flex items-center gap-3 p-3 bg-slate-700/50 rounded-lg">
            <div class="h-8 w-8 bg-green-900/50 rounded-full flex items-center justify-center">
              <span class="text-green-400 font-bold text-sm">3</span>
            </div>
            <div>
              <p class="font-medium text-sm text-white">Delivery</p>
              <p class="text-xs text-slate-400">{deliveryDays}</p>
            </div>
          </div>
        </div>
        <p class="text-xs text-slate-400 mt-4">
          Rush orders may be available. Contact Marketing directly for urgent requests.
        </p>
      </CardContent>
    </Card>
  </div>
</ThemedPage>
