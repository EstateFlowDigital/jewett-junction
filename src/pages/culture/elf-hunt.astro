---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { ElfHuntForm } from '../../components/forms/ElfHuntForm';
import { TreePine, ArrowLeft } from 'lucide-react';
import { initCMS, getPageCopy } from '../../lib/webflow-cms';
import { elfHuntStatus } from '../../lib/elf-hunt';

// "Where's the Elf?" holiday hide and seek (Hailley, Nov 17). Laid out like
// the other form pages (marketing/submit-photo): back arrow, icon headline and
// subtitle, then the form in a card. The words are Hailley's; a Page Copy
// record "elf-hunt" (Hero Headline, Hero Subtitle) can replace the headline
// and subtitle without a code change. The page can be opened before November
// 30 so Hailley can link to it from her announcement, but the form only
// appears while the hunt is open (lib/elf-hunt.ts).

initCMS(Astro.locals);

let copy: any = null;
try {
  copy = await getPageCopy('elf-hunt');
} catch (error) {
  console.error('Error fetching elf hunt copy:', error);
}

const status = elfHuntStatus();
// Stacki previews the page on a local dev server, so the form shows there
// whatever the date. The live site still waits for November 30.
const showForm = status === 'open' || import.meta.env.DEV;
const heroHeadline = copy?.['hero-headline'] || 'Where’s the Elf? Jewett’s Holiday Hide & Seek!';
const heroSubtitle = copy?.['hero-subtitle'] || 'Snap a photo of the elf and upload it below!';
---

<ThemedPage title="Where’s the Elf? | Jewett Junction" theme="dark" currentSection="culture">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a href="/jewett-junction/culture" class="text-slate-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg hover:bg-slate-800" aria-label="Back to Culture">
        <ArrowLeft className="h-5 w-5" aria-hidden="true" />
      </a>
      <div>
        <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
          <TreePine className="h-7 w-7 shrink-0 text-emerald-500" aria-hidden="true" />
          {heroHeadline}
        </h1>
        <p class="text-slate-400 mt-1">{heroSubtitle}</p>
      </div>
    </div>

    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Submit Your Elf Photo</CardTitle>
        <CardDescription className="text-slate-400">
          Submissions reset every Monday when the elf moves to a new location. Each week, the first person to correctly find the elf and submit a photo on Jewett Junction will receive a $10 gift card. Everyone who submits a photo that week will also be entered into that week’s drawing for a $25 Amazon gift card. Stay tuned for the winners!
        </CardDescription>
      </CardHeader>
      <CardContent>
        {showForm && <ElfHuntForm client:load />}
        {!showForm && status === 'upcoming' && (
          <p class="rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-3 text-slate-300">The elf hunt starts Monday, November 30. Check back then to submit your photo.</p>
        )}
        {!showForm && status === 'closed' && (
          <p class="rounded-xl border border-slate-700 bg-slate-800/50 px-4 py-3 text-slate-300">The elf hunt has ended. Thanks to everyone who played!</p>
        )}
      </CardContent>
    </Card>
  </div>
</ThemedPage>
