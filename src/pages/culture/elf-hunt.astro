---
import ThemedPage from '../../layouts/themed-page.astro';
import { ElfHuntForm } from '../../components/pages/ElfHuntForm';
import { initCMS, getPageCopy, decodeHtmlEntities } from '../../lib/webflow-cms';
import { elfHuntStatus } from '../../lib/elf-hunt';

export const prerender = false;

// "Where's the Elf?" holiday hide and seek (Hailley, Nov 17). The words are
// Hailley's. A Page Copy record "elf-hunt" can replace the headline and
// subheadline (Hero Headline, Hero Subtitle) and add a photo (Hero Image)
// without a code change. The page can be opened before November 30 so
// Hailley can link to it from her announcement, but the form only appears
// while the hunt is open (lib/elf-hunt.ts).

initCMS(Astro.locals);

let copy: any = null;
try {
  copy = await getPageCopy('elf-hunt');
} catch (error) {
  console.error('Error fetching elf hunt copy:', error);
}

const status = elfHuntStatus();
// Stacki previews the page on a local dev server, so the form shows there
// whatever the date. The live site still waits for November 30.
const showForm = status === 'open' || import.meta.env.DEV;
const headline = copy?.['hero-headline'] || '🎄 Where’s the Elf? Jewett’s Holiday Hide & Seek!';
const subtitle = copy?.['hero-subtitle']
  ? decodeHtmlEntities(copy['hero-subtitle'])
  : '<p>Snap a photo of the elf and upload it below!</p>';
const photo = copy?.['hero-image']?.url;
---

<ThemedPage title="Where’s the Elf? | Culture | Jewett Junction" theme="dark" currentSection="culture">
  <div class="max-w-3xl">
    <a href="/jewett-junction/culture" class="inline-flex items-center gap-2 text-slate-400 hover:text-blue-400 mb-6 transition-colors min-h-[44px]" aria-label="Back to Culture">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Culture
    </a>

    <article class="glass rounded-2xl overflow-hidden mb-8 border border-slate-800/50">
      {photo && (
        <div class="w-full bg-slate-950 flex justify-center">
          <img src={photo} alt={copy?.['hero-image']?.alt || 'The Jewett elf'} class="max-h-[28rem] w-auto object-contain" loading="eager" />
        </div>
      )}

      <div class="p-6 sm:p-8">
        <span class="inline-block px-3 py-1 text-xs font-medium rounded-full border bg-emerald-500/20 text-emerald-400 border-emerald-500/30 mb-4">Holiday</span>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{headline}</h1>
        <div class="text-slate-300 leading-relaxed mb-8 [&_p]:mb-3 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:mb-1 [&_strong]:text-white" set:html={subtitle} />

        {showForm && <ElfHuntForm client:load />}
        {!showForm && status === 'upcoming' && (
          <p class="rounded-xl border border-slate-700 bg-slate-900/50 px-4 py-3 text-slate-300">The elf hunt starts Monday, November 30. Check back then to send your photo.</p>
        )}
        {!showForm && status === 'closed' && (
          <p class="rounded-xl border border-slate-700 bg-slate-900/50 px-4 py-3 text-slate-300">The elf hunt has ended. Thanks to everyone who played!</p>
        )}

        <p class="text-sm text-slate-400 leading-relaxed mt-8">
          Submissions reset every Monday when the elf moves to a new location. Each week, the first person to correctly find the elf and submit a photo on Jewett Junction will receive a $10 gift card. Everyone who submits a photo that week will also be entered into that week’s drawing for a $25 Amazon gift card. Stay tuned for the winners!
        </p>
      </div>
    </article>
  </div>
</ThemedPage>
