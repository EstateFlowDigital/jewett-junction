---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { CultureContent } from '../../components/pages/CultureContent';
import { initCMS, getCultureStories, getSiteSettings, getCoreValues, getPageCopy, getQuickActions, getDogsOfJewett } from '../../lib/webflow-cms';
import { candyJarStatus, CANDY_JAR_PATH } from '../../lib/candy-jar';

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

let stories: any[] = [];
let settings: any = {};
let coreValues: any[] = [];
let pageCopy: any = null;
let quickActions: any[] = [];
let dogs: any[] = [];
try {
  const [storiesResult, siteSettings, coreValuesResult, copy, quickActionsResult, dogsResult] = await Promise.all([
    getCultureStories(),
    getSiteSettings(),
    getCoreValues(),
    getPageCopy('culture'),
    getQuickActions({ pageSlug: 'culture' }),
    // Its own catch: a Dogs of Jewett hiccup shouldn't blank the whole page.
    getDogsOfJewett().catch(() => ({ items: [], total: 0 })),
  ]);
  stories = storiesResult.items;
  settings = siteSettings;
  coreValues = coreValuesResult.items;
  pageCopy = copy;
  // The Candy Jar box only shows while guessing is open (Oct 24–31), so its
  // Quick Action can stay switched on without anyone flipping it on the day.
  quickActions = quickActionsResult.items.filter(
    (a: any) => !(a['destination-url'] || '').startsWith(CANDY_JAR_PATH) || candyJarStatus() === 'open',
  );
  dogs = dogsResult.items;
} catch (error) {
  console.error('Error fetching culture data:', error);
}
---

<ThemedPage title="Culture | Jewett Junction" theme="dark" currentSection="culture" description="Team wins, recognitions, core values, and community impact at Jewett Construction.">
  <CultureContent client:load theme="dark" stories={stories} settings={settings} coreValues={coreValues} pageCopy={pageCopy} quickActions={quickActions} dogs={dogs} />
</ThemedPage>
