---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { CultureContent } from '../../components/pages/CultureContent';
import { initCMS, getCultureStories, getSiteSettings, getCoreValues, getPageCopy, getQuickActions } from '../../lib/webflow-cms';

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

let stories: any[] = [];
let settings: any = {};
let coreValues: any[] = [];
let pageCopy: any = null;
let quickActions: any[] = [];
try {
  const [storiesResult, siteSettings, coreValuesResult, copy, quickActionsResult] = await Promise.all([
    getCultureStories(),
    getSiteSettings(),
    getCoreValues(),
    getPageCopy('culture'),
    getQuickActions({ pageSlug: 'culture' }),
  ]);
  stories = storiesResult.items;
  settings = siteSettings;
  coreValues = coreValuesResult.items;
  pageCopy = copy;
  quickActions = quickActionsResult.items;
} catch (error) {
  console.error('Error fetching culture data:', error);
}
---

<ThemedPage title="Culture | Jewett Junction" theme="dark" currentSection="culture">
  <CultureContent client:load theme="dark" stories={stories} settings={settings} coreValues={coreValues} pageCopy={pageCopy} quickActions={quickActions} />
</ThemedPage>
