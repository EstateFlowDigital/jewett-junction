---
import ThemedPage from '../../layouts/themed-page.astro';
import { ITHelpdeskContent } from '../../components/pages/ITHelpdeskContent';
import { initCMS, getITKnowledgeBase, getSiteSettings, getPageCopy } from '../../lib/webflow-cms';

initCMS(Astro.locals);

const [itResult, settings, pageCopy] = await Promise.all([
  getITKnowledgeBase({ limit: 50 }),
  getSiteSettings(),
  getPageCopy('it-helpdesk'),
]);
const itArticles = itResult.items;
---

<ThemedPage title="IT Help Desk | Jewett Junction" theme="dark" currentSection="it-helpdesk">
  <ITHelpdeskContent client:load theme="dark" initialItems={itArticles} settings={settings} pageCopy={pageCopy} />
</ThemedPage>
