---
import ThemedPage from '../../layouts/themed-page.astro';
import { ITHelpdeskContent } from '../../components/pages/ITHelpdeskContent';
import { initCMS, getITKnowledgeBase, getSiteSettings } from '../../lib/webflow-cms';

// Initialize CMS with runtime credentials
initCMS(Astro.locals);

// Fetch IT content + global settings server-side
const [itResult, settings] = await Promise.all([
  getITKnowledgeBase({ limit: 50 }),
  getSiteSettings(),
]);
const itArticles = itResult.items;
---

<ThemedPage title="IT Help Desk | Jewett Junction" theme="dark" currentSection="it-helpdesk">
  <ITHelpdeskContent client:load theme="dark" initialItems={itArticles} settings={settings} />
</ThemedPage>
