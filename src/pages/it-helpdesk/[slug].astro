---
import ThemedPage from '../../layouts/themed-page.astro';
import FilePreview from '../../components/shared/FilePreview.astro';
import CmsIcon from '../../components/shared/CmsIcon.astro';
import { initCMS, getITArticleBySlug, getITKnowledgeBase, decodeHtmlEntities } from '../../lib/webflow-cms';

export const prerender = false;

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

const { slug } = Astro.params;

// Fetch the IT article by slug
let item: any = null;
let relatedItems: any[] = [];

try {
  if (slug) {
    item = await getITArticleBySlug(slug);

    // Also fetch other IT articles
    const result = await getITKnowledgeBase({ limit: 4 });
    relatedItems = result.items.filter(r => r.slug !== slug).slice(0, 3);
  }
} catch (error) {
  console.error('Error fetching IT article:', error);
}

// If item not found, redirect
if (!item) {
  return Astro.redirect('/jewett-junction/it-helpdesk');
}

// Get header image
// Hero image — explicit photos only. Uploaded icons are small glyphs and
// look broken scaled to a full-bleed hero; they're surfaced next to the
// title instead.
const headerImage = item.image?.url || item['preview-image']?.url;
const titleIcon = !headerImage ? item.icon?.url : null;
const iconHex = typeof item['icon-color'] === 'string' && /^#[0-9a-fA-F]{6}$/.test(item['icon-color']) ? item['icon-color'] : null;

// Article type badge colors — keys MUST match the article-type dropdown options
// in collections.ts (FAQ, How-To Guide, Troubleshooting, Software, Hardware, Security, Policy).
const typeColors: Record<string, { bg: string; text: string; border: string; gradient: string }> = {
  'FAQ': { bg: 'bg-blue-500/20', text: 'text-blue-400', border: 'border-blue-500/30', gradient: 'from-blue-500 to-indigo-500' },
  'How-To Guide': { bg: 'bg-cyan-500/20', text: 'text-cyan-400', border: 'border-cyan-500/30', gradient: 'from-cyan-500 to-blue-500' },
  'Troubleshooting': { bg: 'bg-amber-500/20', text: 'text-amber-400', border: 'border-amber-500/30', gradient: 'from-amber-500 to-orange-500' },
  'Software': { bg: 'bg-purple-500/20', text: 'text-purple-400', border: 'border-purple-500/30', gradient: 'from-purple-500 to-violet-500' },
  'Hardware': { bg: 'bg-teal-500/20', text: 'text-teal-400', border: 'border-teal-500/30', gradient: 'from-teal-500 to-emerald-500' },
  'Security': { bg: 'bg-red-500/20', text: 'text-red-400', border: 'border-red-500/30', gradient: 'from-red-500 to-rose-500' },
  'Policy': { bg: 'bg-violet-500/20', text: 'text-violet-400', border: 'border-violet-500/30', gradient: 'from-violet-500 to-purple-500' },
  'default': { bg: 'bg-slate-500/20', text: 'text-slate-400', border: 'border-slate-500/30', gradient: 'from-slate-500 to-slate-600' }
};

const typeStyle = typeColors[item['article-type'] || ''] || typeColors.default;

// Difficulty badge colors — keys MUST match the difficulty dropdown options
// in collections.ts (Easy, Intermediate, Advanced).
const difficultyColors: Record<string, string> = {
  'Easy': 'bg-green-500/20 text-green-400 border-green-500/30',
  'Intermediate': 'bg-yellow-500/20 text-yellow-400 border-yellow-500/30',
  'Advanced': 'bg-red-500/20 text-red-400 border-red-500/30'
};
---

<ThemedPage title={`${item.name} | IT Help Desk | Jewett Junction`} theme="dark" currentSection="it-helpdesk">
  <div>
    <!-- Back link -->
    <a href="/jewett-junction/it-helpdesk" class="inline-flex items-center gap-2 text-slate-400 hover:text-cyan-400 mb-6 transition-colors min-h-[44px]" aria-label="Back to IT Help Desk">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to IT Help Desk
    </a>

    <!-- Header Image -->
    {headerImage && (
      <div class="relative h-64 md:h-80 rounded-2xl overflow-hidden mb-8">
        <img
          src={headerImage}
          alt={item.name}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent"></div>
      </div>
    )}

    <!-- Content Card -->
    <div class="glass rounded-2xl p-8 mb-8 border border-slate-800/50">
      <div class="flex items-start gap-6 mb-6">
        {!headerImage && titleIcon && (
          <div
            class="w-16 h-16 rounded-2xl flex items-center justify-center flex-shrink-0"
            style={iconHex ? `background-color: ${iconHex}33` : 'background-color: rgba(148,163,184,0.15)'}
          >
            <CmsIcon url={titleIcon} color={iconHex || undefined} size={32} ariaLabel={item.name} />
          </div>
        )}
        {!headerImage && !titleIcon && (
          <div class={`w-16 h-16 bg-gradient-to-br ${typeStyle.gradient} rounded-2xl flex items-center justify-center flex-shrink-0`}>
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
        )}
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            {item['article-type'] && (
              <span class={`inline-block px-3 py-1 text-xs font-medium rounded-full border ${typeStyle.bg} ${typeStyle.text} ${typeStyle.border}`}>
                {item['article-type']}
              </span>
            )}
            {item.difficulty && (
              <span class={`inline-block px-3 py-1 text-xs font-medium rounded-full border ${difficultyColors[item.difficulty] || difficultyColors['Beginner']}`}>
                {item.difficulty}
              </span>
            )}
            {item.platform && (
              <span class="inline-block px-3 py-1 text-xs font-medium bg-slate-700 text-slate-300 rounded-full">
                {item.platform}
              </span>
            )}
            {item.featured && (
              <span class="inline-block px-3 py-1 text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded-full">
                Featured
              </span>
            )}
          </div>
          <h1 class="text-3xl font-bold text-white">{item.name}</h1>
          {item.views && (
            <p class="text-slate-400 mt-2 flex items-center gap-4">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                {item.views} views
              </span>
              {item['helpful-votes'] && (
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
                  </svg>
                  {item['helpful-votes']} found helpful
                </span>
              )}
            </p>
          )}
        </div>
      </div>

      <!-- Summary -->
      {item.summary && (
        <div class="mb-8 p-4 bg-cyan-500/10 border border-cyan-500/30 rounded-xl">
          <p class="text-cyan-100 leading-relaxed">{item.summary}</p>
        </div>
      )}

      <!-- Full Content -->
      {(item['full-content'] || item.content) && (
        <div class="mb-8 prose prose-invert max-w-none">
          <div class="text-slate-300 leading-relaxed" set:html={decodeHtmlEntities(item['full-content'] || item.content)} />
        </div>
      )}

      <!-- Inline file/video preview -->
      {(item['download-link'] || item['video-tutorial'] || item['video-link']) && (
        <div class="mb-6">
          <FilePreview
            url={item['download-link'] || item['video-tutorial'] || item['video-link']}
            name={item.name}
            accent="cyan"
          />
        </div>
      )}

      <!-- Actions -->
      <div class="flex flex-wrap gap-4">
        {(item['video-tutorial'] || item['video-link']) && (
          <a
            href={item['video-tutorial'] || item['video-link']}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-cyan-500 hover:bg-cyan-600 text-white font-medium rounded-xl transition-colors"
            aria-label="Watch Video Tutorial (opens in new tab)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Watch Video Tutorial
          </a>
        )}
        {item['download-link'] && (
          <a
            href={item['download-link']}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-xl transition-colors"
            aria-label="Download (opens in new tab)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download
          </a>
        )}
      </div>
    </div>

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <div class="glass rounded-2xl p-6 border border-slate-800/50">
        <h2 class="text-xl font-semibold text-white mb-4">Related Articles</h2>
        <div class="grid gap-4">
          {relatedItems.map((related) => {
            const relatedStyle = typeColors[related['article-type'] || ''] || typeColors.default;
            const relatedHex = typeof related['icon-color'] === 'string' && /^#[0-9a-fA-F]{6}$/.test(related['icon-color']) ? related['icon-color'] : null;
            return (
              <a
                href={`/jewett-junction/it-helpdesk/${related.slug}`}
                class="flex items-center gap-4 p-4 min-h-[44px] rounded-xl hover:bg-slate-800/50 transition-colors group"
                aria-label={`View: ${related.name}`}
              >
                {related.icon?.url && (
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                    style={relatedHex ? `background-color: ${relatedHex}33` : 'background-color: rgba(148,163,184,0.15)'}
                  >
                    <CmsIcon url={related.icon.url} color={relatedHex || undefined} size={24} ariaLabel={related.name} />
                  </div>
                )}
                {!related.icon?.url && (
                  <div class={`w-12 h-12 bg-gradient-to-br ${relatedStyle.gradient} rounded-xl flex items-center justify-center flex-shrink-0`}>
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium text-white group-hover:text-cyan-400 transition-colors truncate">
                    {related.name}
                  </h3>
                  <p class="text-sm text-slate-400">{related['article-type'] || 'IT Article'}</p>
                </div>
                <svg class="w-5 h-5 text-slate-500 group-hover:text-cyan-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>
</ThemedPage>
