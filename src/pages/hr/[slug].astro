---
import ThemedPage from '../../layouts/themed-page.astro';
import FilePreview from '../../components/shared/FilePreview.astro';
import CmsIcon from '../../components/shared/CmsIcon.astro';
import { initCMS, getHRContentBySlug, getHRContent, decodeHtmlEntities } from '../../lib/webflow-cms';

export const prerender = false;

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

const { slug } = Astro.params;

// Fetch the HR item by slug
let item: any = null;
let relatedItems: any[] = [];

try {
  if (slug) {
    item = await getHRContentBySlug(slug);

    // Also fetch other HR items
    const result = await getHRContent({ limit: 4 });
    relatedItems = result.items.filter(r => r.slug !== slug).slice(0, 3);
  }
} catch (error) {
  console.error('Error fetching HR content:', error);
}

// If item not found, redirect
if (!item) {
  return Astro.redirect('/jewett-junction/hr');
}

// Hero image — explicit content photos only. Uploaded icons are decorative
// single-color glyphs (often tiny SVGs) and look broken when scaled to a
// full-bleed hero, so they're surfaced next to the title instead.
const headerImage = item.image?.url || item['preview-image']?.url;
const titleIcon = !headerImage ? item.icon?.url : null;
const iconHex = typeof item['icon-color'] === 'string' && /^#[0-9a-fA-F]{6}$/.test(item['icon-color']) ? item['icon-color'] : null;

// Content type badge colors
const typeColors: Record<string, { bg: string; text: string; border: string; gradient: string }> = {
  'Announcement': { bg: 'bg-blue-500/20', text: 'text-blue-400', border: 'border-blue-500/30', gradient: 'from-blue-500 to-cyan-500' },
  'Policy': { bg: 'bg-purple-500/20', text: 'text-purple-400', border: 'border-purple-500/30', gradient: 'from-purple-500 to-violet-500' },
  'Benefit': { bg: 'bg-emerald-500/20', text: 'text-emerald-400', border: 'border-emerald-500/30', gradient: 'from-emerald-500 to-teal-500' },
  'Form': { bg: 'bg-amber-500/20', text: 'text-amber-400', border: 'border-amber-500/30', gradient: 'from-amber-500 to-orange-500' },
  'default': { bg: 'bg-slate-500/20', text: 'text-slate-400', border: 'border-slate-500/30', gradient: 'from-slate-500 to-slate-600' }
};

const typeStyle = typeColors[item['content-type'] || ''] || typeColors.default;
---

<ThemedPage title={`${item.name} | HR | Jewett Junction`} theme="dark" currentSection="hr">
  <div>
    <!-- Back link -->
    <a href="/jewett-junction/hr" class="inline-flex items-center gap-2 text-slate-400 hover:text-purple-400 mb-6 transition-colors min-h-[44px]" aria-label="Back to HR Hub">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to HR Hub
    </a>

    <!-- Header Image -->
    {headerImage && (
      <div class="relative h-64 md:h-80 rounded-2xl overflow-hidden mb-8">
        <img
          src={headerImage}
          alt={item.name}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent"></div>
      </div>
    )}

    <!-- Content Card -->
    <div class="glass rounded-2xl p-8 mb-8 border border-slate-800/50">
      <div class="flex items-start gap-6 mb-6">
        {!headerImage && titleIcon && (
          <div
            class="w-16 h-16 rounded-2xl flex items-center justify-center flex-shrink-0"
            style={iconHex ? `background-color: ${iconHex}33` : 'background-color: rgba(148,163,184,0.15)'}
          >
            <CmsIcon url={titleIcon} color={iconHex || undefined} size={32} ariaLabel={item.name} />
          </div>
        )}
        {!headerImage && !titleIcon && (
          <div class={`w-16 h-16 bg-gradient-to-br ${typeStyle.gradient} rounded-2xl flex items-center justify-center flex-shrink-0`}>
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
        )}
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            {item['content-type'] && (
              <span class={`inline-block px-3 py-1 text-xs font-medium rounded-full border ${typeStyle.bg} ${typeStyle.text} ${typeStyle.border}`}>
                {item['content-type']}
              </span>
            )}
            {item.featured && (
              <span class="inline-block px-3 py-1 text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded-full">
                Featured
              </span>
            )}
          </div>
          <h1 class="text-3xl font-bold text-white">{item.name}</h1>
          {item['applies-to'] && (
            <p class="text-slate-400 mt-2">Applies to: {item['applies-to']}</p>
          )}
        </div>
      </div>

      <!-- Description -->
      {item.description && (
        <div class="mb-8 prose prose-invert max-w-none">
          <div class="text-slate-300 leading-relaxed text-lg" set:html={decodeHtmlEntities(item.description)} />
        </div>
      )}

      <!-- Full Content -->
      {(item['full-content'] || item.content) && (
        <div class="mb-8 prose prose-invert max-w-none border-t border-slate-700/50 pt-6">
          <div class="text-slate-300 leading-relaxed" set:html={decodeHtmlEntities(item['full-content'] || item.content)} />
        </div>
      )}

      <!-- Inline file preview (PDF / image / Office / video) -->
      {item['document-link'] && (
        <div class="mb-6">
          <FilePreview url={item['document-link']} name={item.name} accent="purple" />
        </div>
      )}

      <!-- Effective Date -->
      {item['effective-date'] && (
        <div class="mb-6 p-4 bg-blue-500/10 border border-blue-500/30 rounded-xl">
          <p class="text-blue-400 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Effective: {new Date(item['effective-date']).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </p>
        </div>
      )}

      <!-- Actions -->
      <div class="flex flex-wrap gap-4">
        {item['document-link'] && (
          <a
            href={item['document-link']}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-purple-500 hover:bg-purple-600 text-white font-medium rounded-xl transition-colors"
            aria-label="Download Document (opens in new tab)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download Document
          </a>
        )}
        {item['external-link'] && (
          <a
            href={item['external-link']}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-xl transition-colors"
            aria-label="Open Link (opens in new tab)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Open Link
          </a>
        )}
      </div>
    </div>

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <div class="glass rounded-2xl p-6 border border-slate-800/50">
        <h2 class="text-xl font-semibold text-white mb-4">Related HR Content</h2>
        <div class="grid gap-4">
          {relatedItems.map((related) => {
            const relatedStyle = typeColors[related['content-type'] || ''] || typeColors.default;
            const relatedHex = typeof related['icon-color'] === 'string' && /^#[0-9a-fA-F]{6}$/.test(related['icon-color']) ? related['icon-color'] : null;
            return (
              <a
                href={`/jewett-junction/hr/${related.slug}`}
                class="flex items-center gap-4 p-4 min-h-[44px] rounded-xl hover:bg-slate-800/50 transition-colors group"
                aria-label={`View: ${related.name}`}
              >
                {related.icon?.url && (
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                    style={relatedHex ? `background-color: ${relatedHex}33` : 'background-color: rgba(148,163,184,0.15)'}
                  >
                    <CmsIcon url={related.icon.url} color={relatedHex || undefined} size={24} ariaLabel={related.name} />
                  </div>
                )}
                {!related.icon?.url && (
                  <div class={`w-12 h-12 bg-gradient-to-br ${relatedStyle.gradient} rounded-xl flex items-center justify-center flex-shrink-0`}>
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium text-white group-hover:text-purple-400 transition-colors truncate">
                    {related.name}
                  </h3>
                  <p class="text-sm text-slate-400">{related['content-type'] || 'HR Content'}</p>
                </div>
                <svg class="w-5 h-5 text-slate-500 group-hover:text-purple-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>
</ThemedPage>
