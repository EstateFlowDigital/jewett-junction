                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              </div>
              <div class="font-medium text-white text-sm">Resources</div>
            </a>
            <a href="/jewett-junction/events" class="glass rounded-2xl p-4 border border-slate-700/50 hover:border-amber-500/30 transition-all card-hover text-center group">
              <div class="w-10 h-10 bg-amber-500/20 border border-amber-500/30 rounded-xl flex items-center justify-center mb-3 mx-auto group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div class="font-medium text-white text-sm">Calendar</div>
            </a>
            <a href="/jewett-junction/submit-idea" class="glass rounded-2xl p-4 border border-slate-700/50 hover:border-orange-500/30 transition-all card-hover text-center group">
              <div class="w-10 h-10 bg-orange-500/20 border border-orange-500/30 rounded-xl flex items-center justify-center mb-3 mx-auto group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
              </div>
              <div class="font-medium text-white text-sm">Submit Idea</div>
            </a>
          </div>
        </div>
        )}

        <!-- News & Updates -->
        <div class="mb-10">
          <!-- News Feed -->
          <div class="glass rounded-2xl border border-slate-700/50 overflow-hidden">
            <div class="p-5 border-b border-slate-700/50 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center">
                  <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                </div>
                {newsTitle && <h2 class="font-semibold text-white text-sm sm:text-base">{newsTitle}</h2>}
              </div>
              <a href="/jewett-junction/announcements" class="text-sm text-blue-400 hover:text-blue-300">View All</a>
            </div>
            <div class="divide-y divide-slate-800/50">
              {otherAnnouncements.length > 0 ? (
                otherAnnouncements.map((announcement) => (
                  <a href={`/jewett-junction/announcements/${announcement.slug || announcement.id}`} class="p-4 flex items-center gap-4 hover:bg-slate-800/30 transition-colors block group">
                    {(announcement['blog-body-image']?.url || announcement.image?.url) ? (
                      <div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0">
                        <img src={announcement['blog-body-image']?.url || announcement.image?.url} alt={announcement.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform" loading="lazy" />
                      </div>
                    ) : (
                      <div class={`w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 ${
                        (announcement.priority === 'high' || announcement.priority === 'High' || announcement.priority === 'Urgent') ? 'bg-rose-500/20' : 'bg-blue-500/20'
                      }`}>
                        <svg class={`w-5 h-5 ${(announcement.priority === 'high' || announcement.priority === 'High' || announcement.priority === 'Urgent') ? 'text-rose-400' : 'text-blue-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                      </div>
                    )}
                    <div class="flex-1 min-w-0">
                      <span class={`text-xs font-medium ${(announcement.priority === 'high' || announcement.priority === 'High' || announcement.priority === 'Urgent') ? 'text-rose-400' : 'text-blue-400'}`}>
                        {(announcement.priority === 'high' || announcement.priority === 'High' || announcement.priority === 'Urgent') ? 'Important' : 'Update'}
                      </span>
                      <div class="text-sm text-white">{announcement.name}</div>
                      <div class="text-xs text-slate-500 truncate">{stripHtml(announcement.content)?.substring(0, 60)}...</div>
                    </div>
                    <span class="text-xs text-slate-500 flex-shrink-0">{getRelativeTime(announcement['published-date'])}</span>
                  </a>
                ))
              ) : (
                <div class="p-8 text-center text-slate-500">
                  <p>{ui('empty-announcements', 'No recent announcements')}</p>
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- Employee Spotlight & Open Positions -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Culture Spotlight -->
          <div class="glass rounded-2xl border border-slate-700/50 overflow-hidden">
            <div class="p-5 border-b border-slate-700/50 flex items-center justify-between">
              {cultureCornerTitle && <h2 class="font-semibold text-white text-sm sm:text-base">{cultureCornerTitle}</h2>}
              <a href="/jewett-junction/culture" class="text-sm text-pink-400 hover:text-pink-300">View All</a>
            </div>
            <div class="p-4">
              {cultureStories.length > 0 ? (
                <div class="grid grid-cols-2 gap-3">
                  {cultureStories.slice(0, 4).map((story, index) => (
                    <a href={`/jewett-junction/culture/${story.slug || story.id}`} class={`block group ${index === 0 ? 'col-span-2' : ''}`}>
                      <div class={`relative rounded-xl overflow-hidden ${index === 0 ? 'h-32' : 'h-24'}`}>
                        {story['featured-image']?.url ? (
                          <img src={story['featured-image'].url} alt={story.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                        ) : (
                          <div class="w-full h-full bg-gradient-to-br from-pink-500 to-purple-500 flex items-center justify-center">
                            <span class="text-white text-2xl font-bold">{story.name?.substring(0, 2).toUpperCase() || 'JC'}</span>
                          </div>
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-3">
                          <div>
                            <h3 class="text-white font-medium text-sm truncate group-hover:text-pink-300 transition-colors">{story.name}</h3>
                            <p class="text-slate-300 text-xs">{story.category || 'Story'}</p>
                          </div>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="flex items-start gap-5 p-2">
                  <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-500 rounded-2xl flex items-center justify-center text-white text-xl font-bold flex-shrink-0">
                    JC
                  </div>
                  <div>
                    <h3 class="text-base sm:text-lg font-bold text-white">{ui('culture-empty-title', 'Share Your Story')}</h3>
                    {cultureCornerTitle && <p class="text-slate-400 text-xs sm:text-sm mb-3">{cultureCornerTitle}</p>}
                    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                      {ui('culture-empty-body', "We're looking for stories to feature! Share what makes Jewett special to you.")}
                    </p>
                  </div>
                </div>
              )}
              <div class="mt-4 pt-4 border-t border-slate-700/50 flex items-center justify-between">
                <span class="text-sm text-slate-400">{ui('culture-submit-prompt', 'Have a story to share?')}</span>
                <a href="/jewett-junction/submit-idea" class="text-sm text-pink-400 hover:text-pink-300 font-medium">Submit →</a>
              </div>
            </div>
          </div>

          <!-- Open Positions -->
          <div id="open-positions" class="glass rounded-2xl border border-slate-700/50 overflow-hidden flex flex-col h-full">
            <div class="p-5 border-b border-slate-700/50 flex items-center justify-between">
              {openPositionsTitle && <h2 class="font-semibold text-white text-sm sm:text-base">{openPositionsTitle}</h2>}
              <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-medium rounded-full">{jobs.length} openings</span>
            </div>
            <div class="divide-y divide-slate-800/50 flex-1">
              {jobs.length > 0 ? (
                jobs.slice(0, 8).map((job) => (
                  <a href={job['apply-link'] || 'https://www.jewettconstruction.com/careers/'} target="_blank" rel="noopener noreferrer" class="p-4 flex items-center justify-between hover:bg-slate-800/30 transition-colors group block">
                    <div>
                      <div class="font-medium text-white group-hover:text-blue-400">{job.name}</div>
                      <div class="text-sm text-slate-500">{job.department || 'General'} • {job.location || 'Remote'}</div>
                    </div>
                    <svg class="w-5 h-5 text-slate-600 group-hover:text-blue-400 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))
              ) : (
                <div class="p-8 text-center text-slate-500">
                  <p>{ui('empty-jobs', 'No open positions at this time')}</p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Sidebar tooltip script — same pattern as themed-page.astro.
         Portals a single tooltip onto <body> so the sidebar's overflow
         context can't clip it. -->
    <script is:inline>
      (() => {
        if (typeof window === 'undefined') return;
        const init = () => {
          const links = document.querySelectorAll('aside a[data-tooltip]');
          if (!links.length) return;
          const tip = document.createElement('div');
          tip.className = 'sidebar-tooltip-portal';
          tip.setAttribute('role', 'tooltip');
          document.body.appendChild(tip);
          let raf = 0;
          const show = (e) => {
            const a = e.currentTarget;
            const label = a.getAttribute('data-tooltip');
            if (!label) return;
            const rect = a.getBoundingClientRect();
            tip.textContent = label;
            tip.style.left = (rect.right + 10) + 'px';
            tip.style.top = (rect.top + rect.height / 2) + 'px';
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => tip.classList.add('visible'));
          };
          const hide = () => tip.classList.remove('visible');
          links.forEach((a) => {
            a.addEventListener('mouseenter', show);
            a.addEventListener('mouseleave', hide);
            a.addEventListener('focus', show);
            a.addEventListener('blur', hide);
          });
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
