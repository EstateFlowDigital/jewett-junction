---
export const prerender = false;
import '../../../generated/fonts.css';
import '../../../generated/webflow.css';
import '../../site-components/global.css';
import '../../styles/global.css';
import { MobileNav } from '../../components/layout/MobileNav';
import { FeaturedCarousel } from '../../components/dashboard/FeaturedCarousel';
import CmsIcon from '../../components/shared/CmsIcon.astro';
import { getIcon } from '../../components/admin/icon-map';
import { initCMS, getAnnouncements, getEvents, getJobPostings, getCultureStories, getHRContent, getSafetyContent, getITKnowledgeBase, getMarketingAssets, getBannerMessages, getPageCopy, getIntranetSections, getUIStrings, getQuickActions, decodeHtmlEntities } from '../../lib/webflow-cms';

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

// Fetch CMS data
let announcements: any[] = [];
let events: any[] = [];
let jobs: any[] = [];
let cultureStories: any[] = [];
let hrContent: any[] = [];
let safetyContent: any[] = [];
let itArticles: any[] = [];
let marketingAssets: any[] = [];
let bannerMessages: any[] = [];
let pageCopy: any = null;
let sectionMap = new Map<string, string>();
let uiStrings = new Map<string, string>();
let quickActions: any[] = [];

try {
  const [announcementsRes, eventsRes, jobsRes, cultureRes, hrRes, safetyRes, itRes, marketingRes, bannerRes, copyRes, sectionsRes, uiRes, quickActionsRes] = await Promise.all([
    getAnnouncements({ limit: 10 }),
    getEvents({ limit: 6, upcoming: true }),
    getJobPostings({ limit: 25 }),
    getCultureStories({ limit: 4 }),
    getHRContent({ limit: 3, featured: true }),
    getSafetyContent({ limit: 3, featured: true }),
    getITKnowledgeBase({ limit: 3, featured: true }),
    getMarketingAssets({ limit: 6, featured: true }),
    getBannerMessages({ limit: 20 }),
    getPageCopy('dashboard'),
    getIntranetSections(),
    getUIStrings(),
    getQuickActions({ pageSlug: 'dashboard' }),
  ]);
  announcements = announcementsRes.items;
  events = eventsRes.items;
  jobs = jobsRes.items;
  cultureStories = cultureRes.items;
  hrContent = hrRes.items;
  safetyContent = safetyRes.items;
  itArticles = itRes.items;
  marketingAssets = marketingRes.items;
  bannerMessages = bannerRes.items;
  pageCopy = copyRes;
  sectionMap = new Map(sectionsRes.items.map((s) => [s.slug, s.name]));
  uiStrings = uiRes;
  quickActions = quickActionsRes.items;
} catch (error) {
  console.error('Error fetching CMS data:', error);
}

// Home-page submission boxes (Living the Mission, Sales Lead, ...). These are
// the Quick Actions tagged `dashboard`; anything with a Description renders as
// a large feature card so the team sees the ask, not just a label. Classes are
// spelled out because Tailwind purges `bg-${accent}-500/20`-style strings.
const FEATURE_PALETTE: Record<string, { ring: string; chip: string; icon: string; btn: string; hover: string }> = {
  pink: { ring: 'hover:border-pink-500/40', chip: 'bg-pink-500/15 border-pink-500/30', icon: 'text-pink-400', btn: 'bg-pink-600 hover:bg-pink-500', hover: 'group-hover:text-pink-300' },
  emerald: { ring: 'hover:border-emerald-500/40', chip: 'bg-emerald-500/15 border-emerald-500/30', icon: 'text-emerald-400', btn: 'bg-emerald-600 hover:bg-emerald-500', hover: 'group-hover:text-emerald-300' },
  blue: { ring: 'hover:border-blue-500/40', chip: 'bg-blue-500/15 border-blue-500/30', icon: 'text-blue-400', btn: 'bg-blue-600 hover:bg-blue-500', hover: 'group-hover:text-blue-300' },
  amber: { ring: 'hover:border-amber-500/40', chip: 'bg-amber-500/15 border-amber-500/30', icon: 'text-amber-400', btn: 'bg-amber-600 hover:bg-amber-500', hover: 'group-hover:text-amber-300' },
  purple: { ring: 'hover:border-purple-500/40', chip: 'bg-purple-500/15 border-purple-500/30', icon: 'text-purple-400', btn: 'bg-purple-600 hover:bg-purple-500', hover: 'group-hover:text-purple-300' },
};
const featureActions = quickActions.filter((a: any) => !!a.description);

// Sidebar tooltip labels — fall through to hardcoded fallback when the
// matching intranet-section is missing or inactive.
const label = (slug: string, fallback: string) => sectionMap.get(slug) || fallback;
// UI Strings lookup — admin-editable badges, empty-state copy, etc.
const ui = (key: string, fallback: string) => uiStrings.get(key) || fallback;

// CMS-driven labels (fall back to empty so the section/heading hides if CMS empty)
const heroHeadline = pageCopy?.['hero-headline'] || '';
const heroSubtitle = pageCopy?.['hero-subtitle'] || '';
const importantUpdatesTitle = pageCopy?.['content-block-1-title'] || '';
const photoGalleryTitle = pageCopy?.['content-block-2-title'] || '';
const quickLinksTitle = pageCopy?.['content-block-3-title'] || '';
const newsTitle = pageCopy?.['content-block-4-title'] || '';
const cultureCornerTitle = pageCopy?.['subsection-1-headline'] || '';
const openPositionsTitle = pageCopy?.['subsection-2-headline'] || '';
// Strip outer <p> wrapping from RichText so it inlines cleanly
function stripParaTag(s: string | undefined) {
  if (!s) return '';
  return s.replace(/^<p>/, '').replace(/<\/p>\s*$/, '').trim();
}
const heroSubtitleClean = stripParaTag(heroSubtitle);

// Get featured items from new collections
const featuredHR = hrContent[0];
const featuredSafety = safetyContent.find(s => s.severity === 'Critical' || s.severity === 'Emergency') || safetyContent[0];
const featuredIT = itArticles[0];

// Pre-compute Important Updates card style strings up here — Astro's
// parser chokes on multi-line template literals nested inside JSX
// `style={...}` attribute expressions, so we keep the template clean.
const isHex = (c: any) => typeof c === 'string' && /^#[0-9a-fA-F]{6}$/.test(c);

const featuredHRHex: string | null = featuredHR && isHex(featuredHR['icon-color']) ? featuredHR['icon-color'] : null;
const featuredHRTileBg = 'background-color: ' + (featuredHRHex ? featuredHRHex + '1a' : 'rgba(168, 85, 247, 0.1)');
const featuredHRBadgeBg = 'background-color: ' + (featuredHRHex ? featuredHRHex + '33' : 'rgba(168, 85, 247, 0.2)');
const featuredHRBadgeFg = 'color: ' + (featuredHRHex || '#a855f7');

const featuredSafetyCritical = featuredSafety && (featuredSafety.severity === 'Critical' || featuredSafety.severity === 'Emergency');
const featuredSafetyHex: string | null = featuredSafety && isHex(featuredSafety['icon-color']) ? featuredSafety['icon-color'] : null;
const featuredSafetyDefaultBg = featuredSafetyCritical ? 'rgba(239,68,68,0.2)' : 'rgba(16,185,129,0.2)';
const featuredSafetyDefaultFg = featuredSafetyCritical ? '#f87171' : '#34d399';
const featuredSafetyBadgeBg = 'background-color: ' + (featuredSafetyHex ? featuredSafetyHex + '33' : featuredSafetyDefaultBg);
const featuredSafetyBadgeFg = 'color: ' + (featuredSafetyHex || featuredSafetyDefaultFg);

const featuredITHex: string | null = featuredIT && isHex(featuredIT['icon-color']) ? featuredIT['icon-color'] : null;
const featuredITTileBg = 'background-color: ' + (featuredITHex ? featuredITHex + '1a' : 'rgba(59, 130, 246, 0.1)');
const featuredITBadgeBg = 'background-color: ' + (featuredITHex ? featuredITHex + '33' : 'rgba(59, 130, 246, 0.2)');
const featuredITBadgeFg = 'color: ' + (featuredITHex || '#60a5fa');

function formatTime(dateStr: string) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  if (isNaN(date.getTime())) return '';
  return date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' });
}

function getRelativeTime(dateStr: string) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  if (isNaN(date.getTime())) return '';
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffHours < 1) return 'Just now';
  if (diffHours < 24) return `${diffHours}h ago`;
  if (diffDays === 1) return 'Yesterday';
  return `${diffDays} days ago`;
}

function getDayInfo(dateStr: string) {
  if (!dateStr) return { weekday: '', day: '' };
  const date = new Date(dateStr);
  if (isNaN(date.getTime())) return { weekday: '', day: '' };
  return {
    weekday: date.toLocaleDateString('en-US', { weekday: 'short', timeZone: 'America/New_York' }),
    day: date.toLocaleDateString('en-US', { day: 'numeric', timeZone: 'America/New_York' }),
  };
}

// Strip HTML tags from content. Decode entities FIRST — Webflow returns
// HTML-encoded markup, so raw `&nbsp;` leaks into card text otherwise.
function stripHtml(html: string | undefined) {
  if (!html) return '';
  return decodeHtmlEntities(html).replace(/<[^>]*>/g, '').trim();
}

// Get current date
const today = new Date();
const dateString = today.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });


// Get pinned announcements for carousel (max 6)
const pinnedAnnouncements = announcements.filter(a => a['is-pinned']).slice(0, 6);
// Fallback for single hero if 0-1 pinned items
const featuredAnnouncement = pinnedAnnouncements.length > 0 ? pinnedAnnouncements[0] : announcements[0];
// Other announcements excludes pinned items used in carousel — but when
// EVERY announcement is pinned, fall back to showing them here too instead
// of rendering an empty "News & Updates" widget.
const pinnedIds = new Set(pinnedAnnouncements.map(a => a.id));
const nonPinned = announcements.filter(a => !pinnedIds.has(a.id));
const otherAnnouncements = (nonPinned.length > 0 ? nonPinned : announcements).slice(0, 4);

// Pre-process carousel data (strip HTML server-side to avoid client bundle bloat)
const carouselData = pinnedAnnouncements.map(a => ({
  id: a.id,
  name: a.name,
  slug: a.slug,
  excerpt: stripHtml(a.content)?.substring(0, 120) + ((stripHtml(a.content)?.length || 0) > 120 ? '...' : ''),
  imageUrl: a['blog-body-image']?.url || a.image?.url || '',
  author: a.author || '',
  priority: a.priority || '',
  category: a.category || '',
}));

// Banner messages — fully CMS-driven. When the Banner Messages collection is
// empty, the marquee hides entirely (no hardcoded fallback copy).
const bannerColorClass: Record<string, string> = {
  amber: 'text-amber-300', emerald: 'text-emerald-300', pink: 'text-pink-300',
  cyan: 'text-cyan-300', blue: 'text-blue-300', purple: 'text-purple-300',
};
const hasBannerMessages = bannerMessages.length > 0;
const bannerLoop = hasBannerMessages ? [...bannerMessages, ...bannerMessages] : [];
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard | Jewett Junction</title>
    <style>
      .glow-blue { box-shadow: 0 0 60px rgba(59, 130, 246, 0.15); }
      .glow-green { box-shadow: 0 0 60px rgba(34, 197, 94, 0.15); }
      .glow-purple { box-shadow: 0 0 60px rgba(168, 85, 247, 0.15); }
      .card-hover:hover { transform: translateY(-2px); }
      .glass { background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(12px); }
      @media (max-width: 767px) { .mobile-safe-area { padding-top: max(4.5rem, env(safe-area-inset-top, 0px)); } }
      @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .animate-marquee { animation: marquee 30s linear infinite; }
      .animate-marquee:hover { animation-play-state: paused; }
      /* Keyboard-only focus ring for sidebar icon links */
      aside a:focus-visible {
        outline: 2px solid rgb(59, 130, 246);
        outline-offset: 2px;
        border-radius: 0.75rem;
      }

      /* Styled sidebar tooltips. Pseudo-element approach got clipped by the
         nav's overflow-y; we portal a single tooltip onto <body> via the
         inline script below so it can't be clipped from outside the aside. */
      .sidebar-tooltip-portal {
        position: fixed;
        background: rgba(15, 23, 42, 0.95);
        color: rgb(241 245 249);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.01em;
        padding: 6px 10px;
        border-radius: 8px;
        white-space: nowrap;
        border: 1px solid rgba(59, 130, 246, 0.35);
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(10px);
        opacity: 0;
        pointer-events: none;
        transform: translate(-4px, -50%);
        transition: opacity 120ms ease, transform 120ms ease;
        z-index: 1000;
      }
      .sidebar-tooltip-portal.visible {
        opacity: 1;
        transform: translate(0, -50%);
      }
      .sidebar-tooltip-portal::before {
        content: '';
        position: absolute;
        left: -10px;
        top: 50%;
        transform: translateY(-50%);
        width: 0; height: 0;
        border: 5px solid transparent;
        border-right-color: rgba(15, 23, 42, 0.95);
      }
      @media (max-width: 767px) {
        .sidebar-tooltip-portal { display: none; }
      }
    </style>
  </head>
  <body class="bg-slate-950 text-gray-100 min-h-screen">
    <MobileNav client:load currentTheme="dark" currentPath="/jewett-junction/dashboard" />
    <!-- Gradient Background -->
    <div class="fixed inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 -z-10"></div>
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl -z-10"></div>
    <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl -z-10"></div>

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 bottom-0 w-20 glass border-r border-slate-800/50 z-40 hidden md:flex flex-col items-center py-6">
      <a href="/jewett-junction/dashboard" class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center text-white mb-8 shadow-lg shadow-blue-500/30">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      </a>
      <nav class="flex-1 flex flex-col items-center gap-2 overflow-y-auto py-1">
        <a href="/jewett-junction/dashboard" class="w-11 h-11 bg-blue-500/20 border border-blue-500/30 rounded-xl flex items-center justify-center text-blue-400 transition-all" aria-label={label('dashboard', 'Dashboard')} data-tooltip={label('dashboard', 'Dashboard')}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        </a>
