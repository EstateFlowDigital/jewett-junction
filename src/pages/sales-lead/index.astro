---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { SalesLeadForm } from '../../components/forms/SalesLeadForm';
import { Briefcase, ArrowLeft } from 'lucide-react';
import { initCMS, getPageCopy, getUIStrings } from '../../lib/webflow-cms';

initCMS(Astro.locals);
const [copy, uiMap] = await Promise.all([
  getPageCopy('sales-lead'),
  getUIStrings(),
]);
const uiStrings: Record<string, string> = Object.fromEntries(uiMap);
const heroHeadline = copy?.['hero-headline'] || '';
const heroSubtitle = copy?.['hero-subtitle'] || '';
const backLabel = uiStrings['form-back-to-dashboard'] || 'Back to Dashboard';
---

<ThemedPage title={`${heroHeadline || 'Internal Sales Lead'} | Jewett Junction`} theme="dark" currentSection="dashboard" description="Send a construction opportunity to the Business Development team.">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a href="/jewett-junction/dashboard" class="text-slate-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg hover:bg-slate-800" aria-label={backLabel}>
        <ArrowLeft className="h-5 w-5" aria-hidden="true" />
      </a>
      <div>
        {heroHeadline && (
          <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
            <Briefcase className="h-7 w-7 text-orange-500" aria-hidden="true" />
            {heroHeadline}
          </h1>
        )}
        {heroSubtitle && <p class="text-slate-400 mt-1">{heroSubtitle}</p>}
      </div>
    </div>

    <!-- Sales Lead Form -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Internal Sales Lead Submission</CardTitle>
        <CardDescription className="text-slate-400">
          Use this form to submit potential construction opportunities to the Business Development team. Please provide as much information as possible, including the company name, contact information, project details, and any relevant background. A member of our team will review the information and follow up as appropriate.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <SalesLeadForm client:load uiStrings={uiStrings} />
      </CardContent>
    </Card>
  </div>
</ThemedPage>
