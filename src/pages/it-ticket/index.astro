---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { ITTicketContent } from '../../components/pages/ITTicketContent';
import { initCMS, getSiteSettings, getUIStrings } from '../../lib/webflow-cms';

initCMS(Astro.locals);

let settings: any = {};
let uiStrings: Record<string, string> = {};
try {
  const [s, ui] = await Promise.all([
    getSiteSettings(),
    getUIStrings(),
  ]);
  settings = s;
  uiStrings = Object.fromEntries(ui);
} catch (error) {
  console.error('Error fetching site settings:', error);
}

const itEmail = settings['it-email'] || '';
const itPhone = settings['it-phone'] || '';
const backLabel = uiStrings['form-back-to-it-helpdesk'] || 'Back to IT Helpdesk';
---

<ThemedPage title="Submit IT Ticket | Jewett Junction" theme="dark" currentSection="it-helpdesk">
  <a href="/jewett-junction/it-helpdesk" class="inline-flex items-center gap-2 text-slate-400 hover:text-blue-400 mb-6 transition-colors">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    {backLabel}
  </a>
  <ITTicketContent client:load itEmail={itEmail} itPhone={itPhone} uiStrings={uiStrings} />
</ThemedPage>
