---
import ThemedPage from '../../layouts/themed-page.astro';
import { initCMS, getSafetyContentBySlug, getSafetyContent, decodeHtmlEntities } from '../../lib/webflow-cms';

export const prerender = false;

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

const { slug } = Astro.params;

// Fetch the safety item by slug
let item: any = null;
let relatedItems: any[] = [];

try {
  if (slug) {
    item = await getSafetyContentBySlug(slug);

    // Also fetch other safety items
    const result = await getSafetyContent({ limit: 4 });
    relatedItems = result.items.filter(r => r.slug !== slug).slice(0, 3);
  }
} catch (error) {
  console.error('Error fetching safety content:', error);
}

// If item not found, redirect
if (!item) {
  return Astro.redirect('/jewett-junction/safety');
}

// Get header image
const headerImage = item.image?.url || item['preview-image']?.url || item.thumbnail?.url;

// Content type badge colors
const typeColors: Record<string, { bg: string; text: string; border: string }> = {
  'Alert': { bg: 'bg-red-500/20', text: 'text-red-400', border: 'border-red-500/30' },
  'Protocol': { bg: 'bg-orange-500/20', text: 'text-orange-400', border: 'border-orange-500/30' },
  'Training': { bg: 'bg-blue-500/20', text: 'text-blue-400', border: 'border-blue-500/30' },
  'default': { bg: 'bg-slate-500/20', text: 'text-slate-400', border: 'border-slate-500/30' }
};

const typeStyle = typeColors[item['content-type'] || ''] || typeColors.default;
---

<ThemedPage title={`${item.name} | Safety | Jewett Junction`} theme="dark" currentSection="safety">
  <div>
    <!-- Back link -->
    <a href="/jewett-junction/safety" class="inline-flex items-center gap-2 text-slate-400 hover:text-orange-400 mb-6 transition-colors min-h-[44px]" aria-label="Back to Safety Hub">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Safety Hub
    </a>

    <!-- Header Image -->
    {headerImage && (
      <div class="relative h-64 md:h-80 rounded-2xl overflow-hidden mb-8">
        <img
          src={headerImage}
          alt={item.name}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent"></div>
      </div>
    )}

    <!-- Content Card -->
    <div class="glass rounded-2xl p-8 mb-8 border border-slate-800/50">
      <div class="flex items-start gap-6 mb-6">
        {!headerImage && (
          <div class="w-16 h-16 bg-orange-500/20 rounded-2xl flex items-center justify-center flex-shrink-0">
            <svg class="w-8 h-8 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
        )}
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            {item['content-type'] && (
              <span class={`inline-block px-3 py-1 text-xs font-medium rounded-full border ${typeStyle.bg} ${typeStyle.text} ${typeStyle.border}`}>
                {item['content-type']}
              </span>
            )}
            {item.severity && (
              <span class={`inline-block px-3 py-1 text-xs font-medium rounded-full ${
                item.severity === 'Critical' ? 'bg-red-500/20 text-red-400 border border-red-500/30' :
                item.severity === 'High' ? 'bg-orange-500/20 text-orange-400 border border-orange-500/30' :
                'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30'
              }`}>
                {item.severity} Priority
              </span>
            )}
            {item.featured && (
              <span class="inline-block px-3 py-1 text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded-full">
                Featured
              </span>
            )}
          </div>
          <h1 class="text-3xl font-bold text-white">{item.name}</h1>
          {item['required-for'] && (
            <p class="text-slate-400 mt-2">Required for: {item['required-for']}</p>
          )}
        </div>
      </div>

      <!-- Description -->
      {item.description && (
        <div class="mb-8 prose prose-invert max-w-none">
          <div class="text-slate-300 leading-relaxed text-lg" set:html={decodeHtmlEntities(item.description)} />
        </div>
      )}

      <!-- Full Content -->
      {item.content && (
        <div class="mb-8 prose prose-invert max-w-none border-t border-slate-700/50 pt-6">
          <div class="text-slate-300 leading-relaxed" set:html={decodeHtmlEntities(item.content)} />
        </div>
      )}

      <!-- Expiration Date -->
      {item['expiration-date'] && (
        <div class="mb-6 p-4 bg-amber-500/10 border border-amber-500/30 rounded-xl">
          <p class="text-amber-400 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Expires: {new Date(item['expiration-date']).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </p>
        </div>
      )}

      <!-- Actions -->
      <div class="flex flex-wrap gap-4">
        {item['document-link'] && (
          <a
            href={item['document-link']}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-orange-500 hover:bg-orange-600 text-white font-medium rounded-xl transition-colors"
            aria-label="Download Document (opens in new tab)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download Document
          </a>
        )}
        {item['video-link'] && (
          <a
            href={item['video-link']}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-xl transition-colors"
            aria-label="Watch Video (opens in new tab)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Watch Training Video
          </a>
        )}
      </div>
    </div>

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <div class="glass rounded-2xl p-6 border border-slate-800/50">
        <h2 class="text-xl font-semibold text-white mb-4">Related Safety Content</h2>
        <div class="grid gap-4">
          {relatedItems.map((related) => (
            <a
              href={`/jewett-junction/safety/${related.slug}`}
              class="flex items-center gap-4 p-4 min-h-[44px] rounded-xl hover:bg-slate-800/50 transition-colors group"
              aria-label={`View: ${related.name}`}
            >
              {related.image?.url ? (
                <img src={related.image.url} alt="" class="w-12 h-12 object-cover rounded-xl flex-shrink-0" loading="lazy" />
              ) : (
                <div class="w-12 h-12 bg-orange-500/20 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
              )}
              <div class="flex-1 min-w-0">
                <h3 class="font-medium text-white group-hover:text-orange-400 transition-colors truncate">
                  {related.name}
                </h3>
                <p class="text-sm text-slate-400">{related['content-type'] || 'Safety Content'}</p>
              </div>
              <svg class="w-5 h-5 text-slate-500 group-hover:text-orange-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</ThemedPage>
