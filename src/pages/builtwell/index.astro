---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { BuiltWellIdeaForm } from '../../components/forms/BuiltWellIdeaForm';
import { Sparkles, ArrowLeft } from 'lucide-react';
import { initCMS, getPageCopy, getUIStrings } from '../../lib/webflow-cms';

initCMS(Astro.locals);
const [copy, uiMap] = await Promise.all([
  getPageCopy('builtwell'),
  getUIStrings(),
]);
const uiStrings: Record<string, string> = Object.fromEntries(uiMap);
const heroHeadline = copy?.['hero-headline'] || '';
const heroSubtitle = copy?.['hero-subtitle'] || '';
const backLabel = uiStrings['form-back-to-hr'] || 'Back to HR';
---

<ThemedPage title={`${heroHeadline || 'BuiltWell'} | Jewett Junction`} theme="dark" currentSection="hr" description="Submit an idea to BuiltWell, the Jewett Construction wellness program.">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a href="/jewett-junction/hr" class="text-slate-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg hover:bg-slate-800" aria-label={backLabel}>
        <ArrowLeft className="h-5 w-5" aria-hidden="true" />
      </a>
      <div>
        {heroHeadline && (
          <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
            <Sparkles className="h-7 w-7 text-orange-500" aria-hidden="true" />
            {heroHeadline}
          </h1>
        )}
        {heroSubtitle && <p class="text-slate-400 mt-1">{heroSubtitle}</p>}
      </div>
    </div>

    <!-- BuiltWell Idea Form -->
    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Submit a BuiltWell Idea</CardTitle>
        <CardDescription className="text-slate-400">
          BuiltWell is our employee wellness program. Share your ideas for programs, activities, or improvements you'd like to see.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <BuiltWellIdeaForm client:load uiStrings={uiStrings} />
      </CardContent>
    </Card>
  </div>
</ThemedPage>
