---
import ThemedPage from '../../layouts/themed-page.astro';
import FilePreview from '../../components/shared/FilePreview.astro';
import { initCMS, getResourceBySlug, getResources, getCollectionItem, COLLECTIONS, decodeHtmlEntities } from '../../lib/webflow-cms';

export const prerender = false;

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

const { slug } = Astro.params;

// Fetch the resource by slug, then by id as a fallback so links from
// listings that fell back to `resource.id` (no slug set) still resolve.
let resource: any = null;
let relatedResources: any[] = [];

try {
  if (slug) {
    resource = await getResourceBySlug(slug);
    if (!resource && /^[a-f0-9]{24}$/.test(slug)) {
      resource = await getCollectionItem<any>(COLLECTIONS.resources, slug);
    }

    const result = await getResources({ limit: 8 });
    relatedResources = result.items.filter(r => r.slug !== slug && r.id !== slug).slice(0, 4);
  }
} catch (error) {
  console.error('Error fetching resource:', error);
}

// If resource not found, redirect
if (!resource) {
  return Astro.redirect('/jewett-junction/resources');
}

// Category styling — mirrors the map in ResourcesContent.tsx so the detail
// page colors stay consistent with the listing badges.
const categoryConfig: Record<string, { color: string; gradient: string; label: string; accent: 'orange' | 'purple' | 'blue' | 'cyan' | 'rose' | 'emerald' | 'slate' | 'amber' }> = {
  'safety':           { color: 'orange',  gradient: 'from-orange-500 to-red-500',       label: 'Safety Documents',   accent: 'orange' },
  'safety documents': { color: 'orange',  gradient: 'from-orange-500 to-red-500',       label: 'Safety Documents',   accent: 'orange' },
  'hr':               { color: 'purple',  gradient: 'from-purple-500 to-violet-500',    label: 'HR Forms',           accent: 'purple' },
  'hr forms':         { color: 'purple',  gradient: 'from-purple-500 to-violet-500',    label: 'HR Forms',           accent: 'purple' },
  'human resources':  { color: 'purple',  gradient: 'from-purple-500 to-violet-500',    label: 'HR Forms',           accent: 'purple' },
  'project':          { color: 'blue',    gradient: 'from-blue-500 to-cyan-500',        label: 'Project Templates',  accent: 'blue' },
  'project templates':{ color: 'blue',    gradient: 'from-blue-500 to-cyan-500',        label: 'Project Templates',  accent: 'blue' },
  'it':               { color: 'cyan',    gradient: 'from-cyan-500 to-teal-500',        label: 'IT Guides',          accent: 'cyan' },
  'it guides':        { color: 'cyan',    gradient: 'from-cyan-500 to-teal-500',        label: 'IT Guides',          accent: 'cyan' },
  'marketing':        { color: 'rose',    gradient: 'from-pink-500 to-rose-500',        label: 'Marketing Assets',   accent: 'rose' },
  'training':         { color: 'emerald', gradient: 'from-emerald-500 to-green-500',    label: 'Training Materials', accent: 'emerald' },
  'policies':         { color: 'slate',   gradient: 'from-slate-500 to-slate-600',      label: 'Company Policies',   accent: 'slate' },
  'default':          { color: 'amber',   gradient: 'from-amber-500 to-orange-500',     label: 'Documents',          accent: 'amber' },
};

function getCategoryConfig(category: string | undefined) {
  if (!category) return categoryConfig.default;
  return categoryConfig[category.toLowerCase()] || categoryConfig.default;
}

const cfg = getCategoryConfig(resource.category);

// Get the actual file URL — Webflow stores either as { url } object or string
const fileUrl: string | undefined =
  resource.file?.url ||
  (typeof resource.file === 'string' ? resource.file : undefined);
const externalLink: string | undefined = resource['external-link'];

// Optional Quick Reference: the part of a long document people need fast (the
// Crisis Management Plan's key contact list). Its button sits beside Download
// at the top and opens the panel inline, above the PDF preview.
const quickRefTitle: string = (resource['quick-reference-title'] || '').toString().trim();
const quickRefContent: string = decodeHtmlEntities(resource['quick-reference-content'] || '').trim();
const hasQuickRef = quickRefTitle.length > 0 && quickRefContent.length > 0;

// Header image — only used when the icon is actually an image (not an SVG path)
const iconImageUrl: string | undefined =
  (typeof resource.icon === 'object' && resource.icon?.url) ||
  (typeof resource.icon === 'string' && /^https?:\/\//.test(resource.icon) ? resource.icon : undefined);

// File metadata
const fileType: string = (resource['file-type'] || '').toString();
const fileSize: string = (resource['file-size'] || '').toString();
const lastUpdated: string | undefined = resource['last-updated'];

// Relative time helper
function relativeTime(dateStr: string | undefined): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return '';
  const diffMs = Date.now() - d.getTime();
  const days = Math.floor(diffMs / 86400000);
  if (days < 1) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days < 7) return `${days} days ago`;
  if (days < 30) return `${Math.floor(days / 7)}w ago`;
  if (days < 365) return `${Math.floor(days / 30)}mo ago`;
  return `${Math.floor(days / 365)}y ago`;
}

function formatDate(dateStr: string | undefined): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

// Tags (CSV string in CMS)
const tags: string[] = resource.tags
  ? resource.tags.split(',').map((t: string) => t.trim()).filter(Boolean)
  : [];
---

<ThemedPage title={`${resource.name} | Resources | Jewett Junction`} theme="dark" currentSection="resources">
  <div>
    <!-- Back link -->
    <a
      href="/jewett-junction/resources"
      class={`inline-flex items-center gap-2 text-slate-400 hover:text-${cfg.color}-400 mb-6 transition-colors min-h-[44px]`}
      aria-label="Back to Resources"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Resources
    </a>

    <!-- Optional header image banner (if icon is a real image URL) -->
    {iconImageUrl && (
      <div class="relative h-48 md:h-64 rounded-2xl overflow-hidden mb-8 bg-slate-800">
        <img src={iconImageUrl} alt={resource.name} class="w-full h-full object-contain" loading="eager" />
        <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
      </div>
    )}

    <!-- Main content card -->
    <div class="glass rounded-2xl overflow-hidden mb-8 border border-slate-800/50">
      <!-- Gradient strip header -->
      <div class={`h-2 bg-gradient-to-r ${cfg.gradient}`}></div>

      <div class="p-8">
        <!-- Title row -->
        <div class="flex items-start gap-6 mb-6">
          {!iconImageUrl && (
            <div class={`w-16 h-16 bg-gradient-to-br ${cfg.gradient} rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg shadow-${cfg.color}-500/20`}>
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
          )}
          <div class="flex-1 min-w-0">
            <!-- Badge row -->
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class={`inline-flex items-center px-3 py-1 text-xs font-medium rounded-full bg-${cfg.color}-500/20 text-${cfg.color}-400 border border-${cfg.color}-500/30`}>
                {cfg.label}
              </span>
              {fileType && (
                <span class="inline-block px-3 py-1 text-xs font-medium bg-slate-700 text-slate-300 rounded-full uppercase tracking-wider">
                  {fileType}
                </span>
              )}
              {fileSize && (
                <span class="inline-block px-3 py-1 text-xs font-medium bg-slate-700/50 text-slate-400 rounded-full">
                  {fileSize}
                </span>
              )}
              {resource.featured && (
                <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded-full">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 .587l3.668 7.568L24 9.75l-6 5.852L19.336 24 12 19.897 4.664 24 6 15.602 0 9.75l8.332-1.595z"/>
                  </svg>
                  Featured
                </span>
              )}
              {lastUpdated && (
                <span class="inline-flex items-center gap-1 px-3 py-1 text-xs font-medium bg-slate-800 text-slate-400 rounded-full" title={formatDate(lastUpdated)}>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Updated {relativeTime(lastUpdated)}
                </span>
              )}
            </div>
            <h1 class="text-3xl md:text-4xl font-bold text-white">{resource.name}</h1>
          </div>
        </div>

        <!-- Description -->
        {resource.description && (
          <div class="mb-6 prose prose-invert max-w-none">
            <div class="text-slate-300 leading-relaxed text-lg" set:html={decodeHtmlEntities(resource.description)} />
          </div>
        )}

        <!-- Actions — at the top so Download is the first thing on the page -->
        <div class="flex flex-wrap gap-3 mb-6">
          {fileUrl && (
            <a
              href={fileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-gradient-to-r ${cfg.gradient} hover:opacity-90 text-white font-medium rounded-xl transition-opacity shadow-lg shadow-${cfg.color}-500/20`}
              aria-label="Download File (opens in new tab)"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Download File
            </a>
          )}
          {hasQuickRef && (
            <button
              type="button"
              data-quick-ref-toggle
              aria-expanded="false"
              aria-controls="quick-reference"
              class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-xl transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {quickRefTitle}
            </button>
          )}
          {externalLink && (
            <a
              href={externalLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-xl transition-colors"
              aria-label="Open Link (opens in new tab)"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Open Link
            </a>
          )}
          <button
            type="button"
            data-copy-link
            class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-slate-800/50 hover:bg-slate-700 border border-slate-700 text-slate-300 font-medium rounded-xl transition-colors"
            aria-label="Copy link to this resource"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
            <span data-copy-label>Copy Link</span>
          </button>
        </div>

        {hasQuickRef && (
          <section
            id="quick-reference"
            hidden
            aria-label={quickRefTitle}
            class="mb-6 rounded-2xl border border-slate-700 bg-slate-900/60 p-6 scroll-mt-8"
          >
            <h2 class="text-xl font-semibold text-white mb-4">{quickRefTitle}</h2>
            <div class="quick-ref prose prose-invert max-w-none" set:html={quickRefContent} />
          </section>
        )}

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="mb-6">
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Tags</h3>
            <div class="flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <span class="px-3 py-1 text-sm bg-slate-800 text-slate-300 rounded-full border border-slate-700/50">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Inline file preview (PDF / image / Office / video) -->
        {fileUrl && (
          <div class="mb-6">
            <FilePreview url={fileUrl} name={resource.name} accent={cfg.accent} />
          </div>
        )}

        <!-- Metadata strip -->
        {(fileSize || fileType || lastUpdated || resource['view-count']) && (
          <div class="mt-6 pt-6 border-t border-slate-800/60 grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
            {fileType && (
              <div>
                <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Format</div>
                <div class="text-slate-200 font-medium">{fileType.toUpperCase()}</div>
              </div>
            )}
            {fileSize && (
              <div>
                <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Size</div>
                <div class="text-slate-200 font-medium">{fileSize}</div>
              </div>
            )}
            {lastUpdated && (
              <div>
                <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Last Updated</div>
                <div class="text-slate-200 font-medium">{formatDate(lastUpdated)}</div>
              </div>
            )}
            {resource['view-count'] && (
              <div>
                <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Views</div>
                <div class="text-slate-200 font-medium">{resource['view-count']}</div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- Related Resources -->
    {relatedResources.length > 0 && (
      <div class="glass rounded-2xl p-6 border border-slate-800/50">
        <h2 class="text-xl font-semibold text-white mb-4 flex items-center gap-2">
          <svg class={`w-5 h-5 text-${cfg.color}-400`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
          </svg>
          Related Resources
        </h2>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          {relatedResources.map((related) => {
            const relCfg = getCategoryConfig(related.category);
            const relIcon = (typeof related.icon === 'object' && related.icon?.url) ? related.icon.url : null;
            return (
              <a
                href={`/jewett-junction/resources/${related.slug || related.id}`}
                class={`flex items-center gap-4 p-4 min-h-[44px] rounded-xl hover:bg-slate-800/50 border border-transparent hover:border-${relCfg.color}-500/30 transition-all group`}
                aria-label={`View resource: ${related.name}`}
              >
                {relIcon ? (
                  <img src={relIcon} alt="" class="w-12 h-12 object-cover rounded-xl flex-shrink-0" loading="lazy" />
                ) : (
                  <div class={`w-12 h-12 bg-gradient-to-br ${relCfg.gradient} rounded-xl flex items-center justify-center flex-shrink-0`}>
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class={`font-medium text-white group-hover:text-${relCfg.color}-400 transition-colors truncate`}>
                    {related.name}
                  </h3>
                  <p class="text-sm text-slate-400 truncate">{relCfg.label}</p>
                </div>
                <svg class={`w-5 h-5 text-slate-500 group-hover:text-${relCfg.color}-400 transition-colors flex-shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>
</ThemedPage>

<style is:global>
  /* Quick Reference rich text: role headings as small labels, one contact per paragraph. */
  .quick-ref h3 { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: rgb(148 163 184); margin: 1.5rem 0 0.5rem; }
  .quick-ref h3:first-child { margin-top: 0; }
  .quick-ref p { margin: 0 0 0.75rem; color: rgb(226 232 240); line-height: 1.6; }
  .quick-ref a { color: rgb(253 186 116); text-decoration: none; }
  .quick-ref a:hover { text-decoration: underline; }
</style>

<script>
  // Quick Reference toggle — opens the panel under the buttons. A link to
  // #quick-reference (e.g. shared from Teams) opens it straight away.
  const refToggle = document.querySelector<HTMLButtonElement>('[data-quick-ref-toggle]');
  const refPanel = document.getElementById('quick-reference');
  if (refToggle && refPanel) {
    const setOpen = (open: boolean) => {
      refPanel.hidden = !open;
      refToggle.setAttribute('aria-expanded', String(open));
    };
    refToggle.addEventListener('click', () => {
      const open = refPanel.hidden;
      setOpen(open);
      if (open) refPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    if (window.location.hash === '#quick-reference') setOpen(true);
  }

  // Wire up "Copy Link" button
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  if (btn) {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector<HTMLSpanElement>('[data-copy-label]');
      const original = label?.textContent || 'Copy Link';
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (label) label.textContent = 'Copied!';
      } catch {
        if (label) label.textContent = 'Failed';
      }
      window.setTimeout(() => {
        if (label) label.textContent = original;
      }, 1800);
    });
  }
</script>
