---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { ResourcesContent } from '../../components/pages/ResourcesContent';
import { initCMS, getResources, getPageCopy, getUIStrings } from '../../lib/webflow-cms';

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

// Fetch resources + page copy + ui strings in parallel
let resources: any[] = [];
let pageCopy: any = null;
let uiStrings: Record<string, string> = {};
try {
  const [resourcesResult, copy, ui] = await Promise.all([
    getResources(),
    getPageCopy('resources'),
    getUIStrings(),
  ]);
  resources = resourcesResult.items;
  pageCopy = copy;
  uiStrings = Object.fromEntries(ui);
} catch (error) {
  console.error('Error fetching resources data:', error);
}
const heroHeadline = pageCopy?.['hero-headline'] || '';
---

<ThemedPage title={`${heroHeadline || 'Resources'} | Jewett Junction`} theme="dark" currentSection="resources">
  <ResourcesContent client:load theme="dark" resources={resources} pageCopy={pageCopy} uiStrings={uiStrings} />
</ThemedPage>
