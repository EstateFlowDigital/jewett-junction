---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { ResourcesContent } from '../../components/pages/ResourcesContent';
import { initCMS, getResources, getPageCopy } from '../../lib/webflow-cms';

// Initialize CMS with Cloudflare runtime context
initCMS(Astro.locals);

// Fetch resources + page copy in parallel
let resources: any[] = [];
let pageCopy: any = null;
try {
  const [resourcesResult, copy] = await Promise.all([
    getResources(),
    getPageCopy('resources'),
  ]);
  resources = resourcesResult.items;
  pageCopy = copy;
} catch (error) {
  console.error('Error fetching resources data:', error);
}
---

<ThemedPage title="Resources | Jewett Junction" theme="dark" currentSection="resources">
  <ResourcesContent client:load theme="dark" resources={resources} pageCopy={pageCopy} />
</ThemedPage>
