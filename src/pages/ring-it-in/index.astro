---
export const prerender = false;
import ThemedPage from '../../layouts/themed-page.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { RingItInForm } from '../../components/forms/RingItInForm';
import { PartyPopper, ArrowLeft } from 'lucide-react';
import { initCMS, getSiteSettings, getUIStrings } from '../../lib/webflow-cms';

initCMS(Astro.locals);

let settings: any = {};
let uiStrings: Record<string, string> = {};
try {
  const [s, ui] = await Promise.all([getSiteSettings(), getUIStrings()]);
  settings = s;
  uiStrings = Object.fromEntries(ui);
} catch (error) {
  console.error('Error fetching site settings:', error);
}

// Headline follows the Ring It In box on Home and Culture so the page the
// gong sends you to is recognisably the same thing.
const headline = settings['ring-it-in-headline'] || 'Ring It In';
const backLabel = uiStrings['form-back-to-dashboard'] || 'Back to Dashboard';
---

<ThemedPage
  title={`${headline} | Jewett Junction`}
  theme="dark"
  currentSection="culture"
  description="Submit a shoutout for a Jewett contract win."
>
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a
        href="/jewett-junction/dashboard"
        class="text-slate-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg hover:bg-slate-800"
        aria-label={backLabel}
      >
        <ArrowLeft className="h-5 w-5" aria-hidden="true" />
      </a>
      <div>
        <h1 class="text-2xl font-bold tracking-tight flex items-center gap-3 text-white">
          <PartyPopper className="h-7 w-7 text-amber-500" aria-hidden="true" />
          {headline}
        </h1>
        <p class="text-slate-400 mt-1">Celebrate a contract win and shout out the people behind it.</p>
      </div>
    </div>

    <Card className="bg-slate-800 border-slate-700">
      <CardHeader>
        <CardTitle className="text-white">Submit your Shoutout</CardTitle>
        <CardDescription className="text-slate-400">
          Every contract win is a team effort. Tell us what we landed and who deserves the credit —
          shoutouts are shared with the team so wins get the recognition they earned.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <RingItInForm client:load uiStrings={uiStrings} />
      </CardContent>
    </Card>
  </div>
</ThemedPage>
