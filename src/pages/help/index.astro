---
import ThemedPage from '../../layouts/themed-page.astro';
import { initCMS, getIntranetSections, getPageCopy } from '../../lib/webflow-cms';

export const prerender = false;

// The Help page is fully CMS-driven:
//   - Hero headline + subtitle come from pageCopy(help)
//   - Sections Guide cards come from the Intranet Sections collection
//   - Quick Start / Navigation / Search Tips / Getting Help bodies come from
//     pageCopy(help)'s content-block-N-title/body fields (rich text)
//   - Footer note from pageCopy(help).footer-note
// Anything left as static markup is only icons / layout — no copy.
initCMS(Astro.locals);

let sections: any[] = [];
let copy: any = null;
try {
  const [sectionsResult, pageCopy] = await Promise.all([
    getIntranetSections(),
    getPageCopy('help'),
  ]);
  sections = sectionsResult.items;
  copy = pageCopy;
} catch (error) {
  console.error('help: failed to fetch CMS data', error);
}

const heroHeadline = copy?.['hero-headline'] || 'Help & User Guide';
const heroSubtitle = copy?.['hero-subtitle'] || 'Learn how to use Jewett Junction, your company intranet portal.';
const footerNote = copy?.['footer-note'] || '';
const blocks = [
  {
    title: copy?.['content-block-1-title'] || '',
    body: copy?.['content-block-1-body'] || '',
    iconPath: 'M13 10V3L4 14h7v7l9-11h-7z',
    iconColor: 'text-blue-400',
    featured: true,
  },
  {
    title: copy?.['content-block-2-title'] || '',
    body: copy?.['content-block-2-body'] || '',
    iconPath: 'M4 6h16M4 12h16M4 18h16',
    iconColor: 'text-slate-400',
    featured: false,
  },
  {
    title: copy?.['content-block-3-title'] || '',
    body: copy?.['content-block-3-body'] || '',
    iconPath: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
    iconColor: 'text-slate-400',
    featured: false,
  },
  {
    title: copy?.['content-block-4-title'] || '',
    body: copy?.['content-block-4-body'] || '',
    iconPath: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
    iconColor: 'text-slate-400',
    featured: false,
  },
];
const visibleBlocks = blocks.filter((b) => b.title || b.body);
---

<ThemedPage title={`${heroHeadline} | Jewett Junction`} currentSection="help">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">{heroHeadline}</h1>
      <p class="text-slate-400">{heroSubtitle}</p>
    </div>

    <!-- CMS-driven content blocks -->
    {visibleBlocks.map((block) => (
      <section class="mb-10">
        {block.featured ? (
          <div class="bg-gradient-to-r from-blue-500/20 to-purple-500/20 border border-blue-500/30 rounded-2xl p-6">
            {block.title && (
              <h2 class="text-xl font-semibold text-white mb-3 flex items-center gap-2">
                <svg aria-hidden="true" class={`w-5 h-5 ${block.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={block.iconPath}/>
                </svg>
                {block.title}
              </h2>
            )}
            {block.body && (
              <div class="text-slate-300 prose prose-invert prose-sm max-w-none [&_ol]:list-decimal [&_ol]:list-inside [&_ul]:list-disc [&_ul]:list-inside [&_strong]:text-white" set:html={block.body} />
            )}
          </div>
        ) : (
          <>
            {block.title && (
              <h2 class="text-xl font-semibold text-white mb-4 flex items-center gap-2">
                <svg aria-hidden="true" class={`w-5 h-5 ${block.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={block.iconPath}/>
                </svg>
                {block.title}
              </h2>
            )}
            {block.body && (
              <div class="bg-slate-800/50 border border-slate-700 rounded-xl p-5">
                <div class="text-slate-400 prose prose-invert prose-sm max-w-none [&_ol]:list-decimal [&_ol]:list-inside [&_ul]:list-disc [&_ul]:list-inside [&_strong]:text-white [&_a]:text-blue-400 [&_a:hover]:text-blue-300" set:html={block.body} />
              </div>
            )}
          </>
        )}
      </section>
    ))}

    <!-- Sections Guide — CMS-driven via Intranet Sections collection -->
    {sections.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-white mb-4 flex items-center gap-2">
          <svg aria-hidden="true" class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          Sections Guide
        </h2>

        <div class="space-y-4">
          {sections.map((s) => (
            <a
              href={s['destination-url'] || '#'}
              class={`block bg-slate-800/50 border border-slate-700 hover:border-${s['accent-color'] || 'slate'}-500/50 rounded-xl p-5 transition-colors group min-h-[44px]`}
              aria-label={`Open ${s.name}`}
            >
              <div class="flex items-start gap-3">
                <div class={`w-10 h-10 rounded-lg bg-gradient-to-br ${s.gradient || 'from-slate-500 to-slate-600'} flex items-center justify-center flex-shrink-0`}>
                  {s['icon-svg-path'] && (
                    <svg aria-hidden="true" class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s['icon-svg-path']} />
                    </svg>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class={`font-medium text-white mb-1 group-hover:text-${s['accent-color'] || 'blue'}-300 transition-colors`}>{s.name}</h3>
                  {s.description && (
                    <p class="text-slate-400 text-sm">{s.description}</p>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Footer note (CMS-editable) -->
    {footerNote && (
      <div class="text-center text-slate-500 text-sm pt-6 border-t border-slate-800">
        <p>{footerNote}</p>
      </div>
    )}
  </div>
</ThemedPage>
